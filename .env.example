# Copy to `.env` and fill in (`.env` is gitignored). Get OAuth client from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo mode
# - `/demo/*` routes return 404 unless DEMO_ENABLED="true"
# - Optional: use a separate database for demo shard in production
DEMO_ENABLED=false
DEMO_DATABASE_URL=
