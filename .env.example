# Copy to `.env` and fill in (`.env` is gitignored). Get OAuth client from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Demo mode
# - `/demo/*` routes return 404 unless DEMO_ENABLED="true"
# - Default: demo shares DATABASE_URL / primary DB; data lives in PostgreSQL schema `demo` (duplicate tables).
# - Optional: set DEMO_DATABASE_URL to use a separate database instead (tables in `public` there).
DEMO_ENABLED=false
DEMO_DATABASE_URL=
