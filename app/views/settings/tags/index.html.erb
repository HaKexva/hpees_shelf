<% content_for :title, "標籤設定" %>

<div class="w-full max-w-4xl">
  <h1 class="font-bold text-4xl mb-2">標籤設定</h1>

  <p class="text-sm text-gray-600 mb-4">標籤名稱請直接在下方各組別的「選項」欄位輸入，編輯後會自動儲存並建立尚未存在的標籤；下方統計會顯示最新內容。</p>

  <div class="mb-8 p-4 bg-gray-50 border border-gray-200 rounded-lg">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-semibold text-lg">標籤規則（組別與選項）</h2>
      <span class="text-sm text-gray-500">編輯、新增、刪除後皆會自動儲存</span>
    </div>

    <%= form_with url: update_rules_settings_tags_path, method: :patch, local: true, data: { controller: "auto-save", auto_save_delay_value: "0" } do |f| %>
      <% (@groups || []).each_with_index do |group, gi| %>
        <div class="tag-rule-group border border-gray-300 rounded-lg p-4 mb-4 bg-white">
          <div class="flex flex-wrap items-end gap-4 mb-3">
            <%= hidden_field_tag "groups[#{gi}][_index]", gi %>
            <div>
              <label class="block text-xs text-gray-500 mb-1">組別名稱</label>
              <%= text_field_tag "groups[#{gi}][label]", group["label"], class: "rounded-md border border-gray-300 px-3 py-2 w-40", placeholder: "例如：書來源" %>
            </div>
            <div>
              <label class="block text-xs text-gray-500 mb-1">適用於</label>
              <%= select_tag "groups[#{gi}][target]", options_for_select([ [ "書籍", "book" ], [ "人員（學生／管理員）", "user" ] ], group["target"].to_s.presence || "book"), { class: "rounded-md border border-gray-300 px-3 py-2" } %>
            </div>
            <label class="inline-flex items-center gap-2 cursor-pointer">
              <%= check_box_tag "groups[#{gi}][required]", "1", group["required"], class: "rounded border-gray-300" %>
              <span class="text-sm">必填</span>
            </label>
            <div class="flex items-center gap-4">
              <span class="text-sm text-gray-600">選取方式：</span>
              <label class="inline-flex items-center gap-1 cursor-pointer">
                <%= radio_button_tag "groups[#{gi}][single_select]", "1", group["single_select"], class: "border-gray-300" %>
                <span class="text-sm">單選</span>
              </label>
              <label class="inline-flex items-center gap-1 cursor-pointer">
                <%= radio_button_tag "groups[#{gi}][single_select]", "0", !group["single_select"], class: "border-gray-300" %>
                <span class="text-sm">複選</span>
              </label>
            </div>
            <%= link_to "刪除組別", delete_group_settings_tags_path(group_id: @tag_rule_groups[gi]&.id), data: { turbo_method: :delete, turbo_confirm: "確定要刪除此組別？" }, class: "rounded-md px-2.5 py-1.5 text-sm bg-red-100 hover:bg-red-200 text-red-800 font-medium" %>
          </div>

            <p class="text-xs text-gray-500 mb-2">
              選項（對應標籤名稱）。若希望在書籍或人員表單中，勾選某個選項後再多出一個額外欄位，可設定下列兩欄：
              「表單附加欄位說明」會顯示在該欄位旁作為提示文字，
              「表單附加欄位內容」則決定此欄位是手動輸入，還是從管理員、人員或屆數名單產生選單。
              僅「書來源」組的「屆數切換時」會影響學年度切換後書籍的處理方式。
            </p>
            <% relocation_options = [ [ "—", "" ], [ "維持原班級", "keep" ], [ "詢問去向", "ask" ], [ "不處理", "none" ] ].freeze %>
            <% option_source_choices = [ [ "不需額外欄位", "" ], [ "手動輸入", "manual" ], [ "來自管理員名單", "admins" ], [ "來自人員名單", "users" ], [ "來自屆數名單", "batch_years" ] ].freeze %>
            <% is_book_group = (group["target"].to_s != "user") %>
            <table class="min-w-full text-sm">
              <thead>
                <tr class="border-b border-gray-200 text-left text-gray-600">
                  <th class="py-2 pr-4">選項（標籤）</th>
                  <th class="py-2 pr-4">表單附加欄位說明</th>
                  <th class="py-2 pr-4">表單附加欄位內容</th>
                  <% if is_book_group %>
                    <th class="py-2 pr-4">屆數切換時</th>
                  <% end %>
                  <th class="py-2 w-16"></th>
                </tr>
              </thead>
              <tbody>
                <% (group["options"] || []).each_with_index do |opt, oi| %>
                  <tr class="border-b border-gray-100">
                    <%= hidden_field_tag "groups[#{gi}][options][#{oi}][_option_index]", oi %>
                    <td class="py-2 pr-4">
                      <%= text_field_tag "groups[#{gi}][options][#{oi}][tag_name]", opt["tag_name"], placeholder: "輸入標籤名稱", class: "rounded-md border border-gray-300 px-2 py-1.5 w-full max-w-xs" %>
                    </td>
                    <td class="py-2 pr-4">
                      <%= text_field_tag "groups[#{gi}][options][#{oi}][popup_prompt]", opt["popup_prompt"], placeholder: "例：請選擇老師（管理員）", class: "rounded-md border border-gray-300 px-2 py-1.5 w-full max-w-xs" %>
                    </td>
                    <td class="py-2 pr-4">
                      <%= select_tag "groups[#{gi}][options][#{oi}][option_source]", options_for_select(option_source_choices, opt["option_source"].to_s.presence || ""), { include_blank: false, class: "rounded-md border border-gray-300 px-2 py-1.5 w-full min-w-[8rem] max-w-[11rem]" } %>
                    </td>
                    <% if is_book_group %>
                      <td class="py-2 pr-4">
                        <%= select_tag "groups[#{gi}][options][#{oi}][relocation_behavior]", options_for_select(relocation_options, opt["relocation_behavior"].to_s.presence || ""), { include_blank: false, class: "rounded-md border border-gray-300 px-2 py-1.5 w-full min-w-[8rem] max-w-[11rem]" } %>
                      </td>
                    <% end %>
                    <td class="py-2">
                      <%= link_to "刪除", delete_option_settings_tags_path(group_id: @tag_rule_groups[gi]&.id, option_index: oi), data: { turbo_method: :delete, turbo_confirm: "確定刪除此選項？" }, class: "text-red-600 hover:text-red-800 text-xs" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
            <%= link_to "＋ 新增選項（加入此組）", add_option_settings_tags_path(group_id: @tag_rule_groups[gi]&.id), data: { turbo_method: :post }, class: "mt-2 inline-block rounded-md px-2.5 py-1.5 text-sm bg-gray-200 hover:bg-gray-300 font-medium" %>
        </div>
      <% end %>

      <div class="mt-4 pt-4 border-t border-gray-300">
        <span class="text-sm text-gray-500 mr-2">與上方組別並列：</span>
        <%= link_to "＋ 新增組別", add_group_settings_tags_path, data: { turbo_method: :post }, class: "rounded-md px-3.5 py-2 bg-green-600 hover:bg-green-500 text-white font-medium inline-block" %>
      </div>

    <% end %>
  </div>

  <div class="mb-8">
    <h2 class="font-semibold text-lg mb-3">標籤統計（依標籤規則自動列出）</h2>
    <p class="text-sm text-gray-500 mb-2">下列為標籤規則中各選項的標籤名稱與目前使用次數，隨規則自動更新。可在此刪除尚未被任何書籍使用的標籤。</p>
    <% if @tag_stats.present? %>
      <ul class="space-y-2">
        <% @tag_stats.each do |stat| %>
          <li class="flex items-center justify-between gap-4 py-2 px-3 rounded-md bg-gray-50 border border-gray-200">
            <span class="font-medium"><%= stat[:name].presence || "（空白）" %></span>
            <span class="flex items-center gap-3">
              <span class="text-sm text-gray-500 w-24 text-right tabular-nums">使用次數：<%= stat[:count] %></span>
              <% if stat[:tag_id].present? %>
                <%= button_to "刪除", settings_tag_path(stat[:tag_id]), method: :delete, class: "rounded-md px-2.5 py-1.5 text-sm bg-red-100 hover:bg-red-200 text-red-800 font-medium cursor-pointer", data: { turbo_confirm: "確定要刪除標籤「#{stat[:name]}」嗎？若書籍正在使用此標籤，該標籤會從書籍上移除。" } %>
              <% end %>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-500">尚無標籤規則選項，請在上方組別中輸入選項（標籤名稱），編輯後會自動儲存。</p>
    <% end %>
  </div>

  <div class="mt-6">
    <%= link_to "返回首頁", root_path, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-200 font-medium" %>
  </div>
</div>
