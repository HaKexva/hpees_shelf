<% content_for :title, @batch.name %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl"><%= @batch.name %></h1>
    <div class="flex gap-2">
      <%= link_to "編輯屆數", edit_batch_path(@batch), class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 font-medium" %>
      <%= link_to "書籍列表", books_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
    </div>
  </div>

  <h2 class="font-semibold text-lg mb-4">此屆數書籍（<%= @books.size %> 本）</h2>

  <% if @books.any? %>
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">書名</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ISBN</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">冊數</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">總數</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @books.each do |book| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= link_to book.title, book, class: "text-blue-600 hover:text-blue-900" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.isbn %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.volume %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.total %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-gray-500">此屆數尚無書籍。請在新增書籍時選擇此屆數。</p>
  <% end %>

  <p class="mt-6">
    <%= link_to "返回屆數列表", batches_path, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 font-medium" %>
  </p>
</div>
