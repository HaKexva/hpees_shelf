<% content_for :title, "屆數列表" %>

<div class="w-full max-w-5xl mx-auto px-4 sm:px-0 pb-8">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
    <div>
      <h1 class="font-bold text-2xl sm:text-4xl text-gray-900">屆數列表</h1>
      <p class="mt-1 text-sm text-gray-500">目前學年度：<%= BatchYear.display_current_school_year_roc %>學年度</p>
    </div>
    <div class="flex flex-wrap gap-2 items-center">
      <%= button_to "建立目前所有屆數", auto_create_batch_years_path, method: :post, class: "rounded-md px-3.5 py-2.5 bg-green-600 hover:bg-green-500 text-white font-medium cursor-pointer", form: { data: { turbo_confirm: "將自動建立所有目前屆數。確定？" } } %>
      <% if BatchYear.show_advance_school_year_button? %>
        <% next_roc = BatchYear.display_current_school_year_roc + 1 %>
        <%= button_to "切換至#{next_roc}學年度", reassign_grades_batch_years_path, method: :post, class: "rounded-md px-3.5 py-2.5 bg-amber-600 hover:bg-amber-500 text-white font-medium cursor-pointer", form: { data: { turbo_confirm: "切換後即不可切回，確定？？" } } %>
      <% end %>
      <%= link_to "新增屆數", new_batch_year_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
    </div>
  </div>

  <%= form_with url: bulk_destroy_batch_years_path, method: :delete, id: "bulk-destroy-batch-years-form" do |f| %>
    <div class="hidden md:block">
      <div class="flex gap-2 items-center mb-4">
        <button type="submit" class="rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white font-medium cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" id="bulk-destroy-btn" disabled data-turbo-confirm="確定要刪除所選的屆數嗎？">
          刪除所選
        </button>
        <span class="text-sm text-gray-500" id="bulk-destroy-count">已選 0 個</span>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left w-12 sticky left-0 bg-gray-50 z-10 border-r border-gray-200">
                <% if @batch_years.any? %>
                  <input type="checkbox" id="select-all-batch-years" class="rounded" title="全選">
                <% end %>
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">屆數</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">年級</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">書籍數</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">人員數</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">編輯</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% if @batch_years.any? %>
              <% @batch_years.each do |batch_year| %>
                <tr class="hover:bg-gray-50 cursor-pointer batch-year-row" data-batch-year-url="<%= batch_year_path(batch_year) %>" role="button" tabindex="0">
                  <td class="px-4 py-4 w-12 sticky left-0 bg-white z-10 border-r border-gray-200 align-middle" data-no-row-click>
                    <input type="checkbox" name="batch_year_ids[]" value="<%= batch_year.id %>" class="batch-year-checkbox rounded" title="選擇以刪除">
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= batch_year.display_label %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= grade_label(batch_year.grade_id) %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= batch_year.books.count %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= batch_year.users.count %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2" data-no-row-click>
                    <%= link_to edit_batch_year_path(batch_year), class: "inline-flex text-indigo-600 hover:text-indigo-900", title: "編輯", aria: { label: "編輯" } do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                      </svg>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="px-6 py-10 text-center text-gray-500">尚無屆數。</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <!-- 手機版：Card 風格列表 -->
  <div class="block md:hidden pb-8">
    <% if @batch_years.any? %>
      <div class="space-y-4">
        <% @batch_years.each do |batch_year| %>
          <div class="bg-white rounded-2xl shadow-md border border-gray-100 overflow-hidden">
            <div class="p-4">
              <div class="flex justify-between items-start gap-3">
                <div class="min-w-0 flex-1">
                  <p class="text-base font-semibold text-gray-900"><%= batch_year.display_label %></p>
                  <p class="text-xs text-gray-500 mt-1">
                    <% label = grade_label(batch_year.grade_id) %>
                    <%= label == "畢業" || label == "—" ? label : "#{label} 年級" %>
                  </p>
                </div>
                <div class="flex items-start gap-1.5" data-no-row-click>
                  <%= link_to edit_batch_year_path(batch_year), class: "inline-flex items-center justify-center w-9 h-9 rounded-full bg-indigo-50 text-indigo-600 hover:bg-indigo-100 active:bg-indigo-200 text-sm font-medium transition-colors", title: "編輯", aria: { label: "編輯" } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                  <% end %>
                  <%= button_to batch_year_path(batch_year), method: :delete, form: { class: "inline" }, class: "inline-flex items-center justify-center w-9 h-9 rounded-full bg-red-50 text-red-600 hover:bg-red-100 active:bg-red-200 border-0 cursor-pointer text-sm font-medium transition-colors", data: { turbo_confirm: "確定要刪除此屆數嗎？" }, title: "刪除", aria: { label: "刪除" } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 7h12M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2m-9 0h10l-1 12a2 2 0 01-2 2H9a2 2 0 01-2-2L6 7z" />
                    </svg>
                  <% end %>
                </div>
              </div>
              <div class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
                <div class="flex gap-1.5"><span class="text-gray-400 shrink-0">書籍數</span><span class="text-gray-700"><%= batch_year.books.count %></span></div>
                <div class="flex gap-1.5"><span class="text-gray-400 shrink-0">人員數</span><span class="text-gray-700"><%= batch_year.users.count %></span></div>
              </div>
            </div>
            <div class="px-4 py-3 bg-gray-50/80 flex justify-start border-t border-gray-100 text-xs text-gray-500">
              <%= link_to "查看詳細", batch_year_path(batch_year), class: "underline underline-offset-2 decoration-gray-300 hover:decoration-gray-500" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="py-16 text-center">
        <p class="text-gray-500 text-sm">尚無屆數。</p>
      </div>
    <% end %>
  </div>

  <script>
    (function() {
      var form = document.getElementById('bulk-destroy-batch-years-form');
      if (!form) return;
      var checkboxes = form.querySelectorAll('.batch-year-checkbox');
      var selectAll = document.getElementById('select-all-batch-years');
      var btn = document.getElementById('bulk-destroy-btn');
      var countEl = document.getElementById('bulk-destroy-count');

      function updateState() {
        var n = form.querySelectorAll('.batch-year-checkbox:checked').length;
        btn.disabled = n === 0;
        countEl.textContent = '已選 ' + n + ' 個';
        if (selectAll) selectAll.checked = n > 0 && n === checkboxes.length;
        if (selectAll) selectAll.indeterminate = n > 0 && n < checkboxes.length;
      }

      checkboxes.forEach(function(cb) { cb.addEventListener('change', updateState); });
      if (selectAll) selectAll.addEventListener('change', function() {
        checkboxes.forEach(function(cb) { cb.checked = selectAll.checked; });
        updateState();
      });
      updateState();

      form.querySelectorAll('.batch-year-row').forEach(function(row) {
        row.addEventListener('click', function(e) {
          if (e.target.closest('[data-no-row-click]')) return;
          var url = row.getAttribute('data-batch-year-url');
          if (url) window.location = url;
        });
        row.addEventListener('keydown', function(e) {
          if (e.key !== 'Enter' && e.key !== ' ') return;
          if (e.target.closest('[data-no-row-click]')) return;
          e.preventDefault();
          var url = row.getAttribute('data-batch-year-url');
          if (url) window.location = url;
        });
      });
    })();
  </script>
</div>
