<% content_for :title, "編輯屆數" %>

<div class="w-full">
  <div>
    <h1 class="font-bold text-4xl mb-6">編輯屆數</h1>

    <%= render "form", batch_year: @batch_year, submit_in_page: true %>

    <div class="mt-4 flex flex-row flex-nowrap gap-2 items-center">
      <%= submit_tag "儲存", form: dom_id(@batch_year), class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
      <%= button_to "刪除此屆數",
                    @batch_year,
                    method: :delete,
                    data: { turbo_confirm: "確定要刪除此屆數嗎？" },
                    form: { class: "inline" },
                    class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white font-medium cursor-pointer" %>
      <%= link_to "返回屆數列表", batch_years_path, class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium" %>
    </div>
  </div>
</div>
