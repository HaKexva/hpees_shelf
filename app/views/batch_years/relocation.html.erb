<% content_for :title, "指定屆數" %>
<% draft = @relocation_draft || {} %>
<% next_roc_on_commit = BatchYear.display_current_school_year_roc + 1 %>
<% relocation_by_opts = relocation_batch_year_select_options(@batch_years, staged_commit: @relocation_school_year_pending_commit) %>
<% relocation_by_office_opts = relocation_batch_year_select_options(@batch_years_with_office, staged_commit: @relocation_school_year_pending_commit) %>

<div class="w-full">
  <div class="mb-6">
    <h1 class="font-bold text-4xl">指定屆數</h1>
    <% if @relocation_school_year_pending_commit %>
      <p class="text-gray-600 mt-1">學年度將於您送出「儲存屆數指定」後更新為 <%= next_roc_on_commit %> 學年度；儲存草稿不會變更學年度或屆數資料。書籍請見下方「書籍」區塊；須處理之書須從下拉選單重新選擇新屆數（不會沿用原屆數）。書籍區屆數下拉的「年級」為升學年後之預覽（與送出後相同），尚未寫入資料庫。</p>
    <% else %>
      <p class="text-gray-600 mt-1">學年度已切換，請為下列人員指定新屆數；書籍請見下方「書籍」區塊。每本須處理之書皆須從下拉選單重新選擇新屆數（不會沿用原屆數）。</p>
    <% end %>
  </div>

  <%= form_with url: apply_relocation_batch_years_path,
                method: :post,
                html: {
                  class: "space-y-8",
                  id: "relocation-form",
                  data: {
                    turbo: false,
                    controller: "relocation-guard",
                    relocation_guard_draft_saved_value: (@relocation_draft_saved ? "true" : "false"),
                    relocation_guard_batch_year_grade_map_value: (@relocation_batch_year_grade_map || {}).to_json,
                    relocation_guard_current_user_id_value: current_user&.id.to_i,
                    relocation_guard_superadmin_value: (current_user&.superadmin? ? "true" : "false"),
                    action: "change->relocation-guard#onChange input->relocation-guard#onChange"
                  }
                } do |f| %>
    <%= render "relocation_books" %>

    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="font-semibold text-lg mb-2">年級負責老師（每個有老師的年級 1 位）</h2>
      <p class="text-sm text-gray-600 mb-4">請為「有任教老師」的年級勾選 1 位；沒有老師的年級會略過。完成書籍／老師屆數選擇後請先按「儲存草稿」，才會開放移動。</p>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">年級</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">老師</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% teachers = (@pending_users || []).to_a %>
            <% grade_teacher_draft = draft["grade_teacher_ids"] || {} %>
            <% teacher_batch_draft = draft["teacher_batch_year_ids"] || {} %>
            <% (1..6).each do |g| %>
              <tr>
                <td class="px-4 py-2 text-sm font-medium text-gray-900"><%= g %> 年級</td>
                <td class="px-4 py-2">
                  <div class="flex flex-wrap gap-3">
                    <% teachers.each do |t| %>
                      <% checked = grade_teacher_draft[g.to_s].to_s == t.id.to_s %>
                      <% # Initial render (no-JS / first paint): only show if this teacher currently covers this grade. %>
                      <% selected_batch_ids =
                           Array(teacher_batch_draft[t.id.to_s].presence || t.member_batch_year_ids)
                             .reject(&:blank?).map(&:to_s) %>
                      <% visible = selected_batch_ids.any? { |id| relocation_choice_grade(id, staged_commit: @relocation_school_year_pending_commit) == g } %>
                      <label
                        class="inline-flex items-center gap-2 text-sm text-gray-800 hidden"
                        style="display: <%= visible ? 'inline-flex' : 'none' %>;"
                        data-relocation-guard-grade-teacher-label
                        data-grade="<%= g %>"
                        data-teacher-id="<%= t.id %>"
                      >
                        <input
                          type="checkbox"
                          name="grade_teacher_ids[<%= g %>]"
                          value="<%= t.id %>"
                          <%= "checked" if checked %>
                          class="rounded border-gray-300 text-blue-600 focus:ring-blue-600"
                          data-relocation-guard-grade-teacher-checkbox
                          data-grade="<%= g %>"
                          data-teacher-id="<%= t.id %>"
                          <%= "disabled" if !current_user&.superadmin? && current_user&.id.to_i != t.id.to_i %>
                        >
                        <span><%= t.name %></span>
                        <span class="hidden" data-relocation-guard-grade-teacher-batches></span>
                      </label>
                    <% end %>
                  </div>
                  <p class="mt-2 text-xs text-gray-400 hidden" data-relocation-guard-empty-grade data-grade="<%= g %>">此年級目前沒有任教老師，儲存時會略過。</p>
                  <% if teachers.any? %>
                    <p class="mt-2 text-xs text-gray-500">僅顯示有任教該年級的老師（依下方「任教屆數（複選）」）。</p>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <% if @pending_users.present? %>
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="font-semibold text-lg mb-4">人員（老師）</h2>
        <p class="text-sm text-gray-600 mb-4">每位老師請用「複選」選擇其任教屆數（至少選 1 個）。切換學年度時可勾選即將新增的一年級屆數。</p>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">姓名</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">目前任教屆數</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">任教屆數（複選）</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @pending_users.each do |user| %>
                <tr>
                  <td class="px-4 py-2 text-sm font-medium text-gray-900"><%= user.name %></td>
                  <td class="px-4 py-2 text-sm text-gray-600"><%= user.member_batch_year_ids.map { |id| BatchYear.find_by(id: id)&.display_label_with_grade }.compact.join("、") %></td>
                  <td class="px-4 py-2">
                    <% draft_ids = draft.dig("teacher_batch_year_ids", user.id.to_s) %>
                    <% selected_keys = Array(draft_ids.presence || user.member_batch_year_ids).map(&:to_s) %>
                    <% selected_for_select = selected_keys.map { |s| incoming_grade1_choice?(s) ? s : s.to_i } %>
                    <div data-controller="extra-batch-select">
                      <%= select_tag "teacher_batch_year_ids[#{user.id}][]",
                                     options_for_select(relocation_by_opts, selected_for_select),
                                     multiple: true,
                                     required: true,
                                     class: "hidden",
                                     data: { extra_batch_select_target: "select" } %>

                      <div class="border border-gray-300 rounded-md px-3 py-2 bg-white w-80">
                        <button type="button"
                                class="w-full flex justify-between items-start gap-2 text-sm text-gray-700"
                                data-action="click->extra-batch-select#togglePanel"
                                aria-haspopup="listbox">
                          <span data-extra-batch-select-target="summary" class="text-left flex-1 min-w-0 whitespace-normal break-words">尚未選擇屆數</span>
                          <span class="text-gray-400 text-xs">▼</span>
                        </button>
                        <div class="mt-2 border-t border-gray-200 pt-2 hidden max-h-48 overflow-y-auto"
                             data-extra-batch-select-target="panel">
                          <div class="flex justify-between items-center mb-1">
                            <span class="text-xs text-gray-500">勾選任教屆數</span>
                            <button type="button"
                                    class="text-xs text-gray-400 hover:text-gray-600"
                                    data-action="click->extra-batch-select#clearAll">
                              清除選取
                            </button>
                          </div>
                          <div class="space-y-1 text-sm">
                            <% if @relocation_school_year_pending_commit %>
                              <label class="flex items-center gap-2">
                                <input type="checkbox"
                                       class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-600"
                                       value="<%= BatchYearsHelper::INCOMING_GRADE1_KEY %>"
                                       data-extra-batch-select-target="checkbox"
                                       data-action="change->extra-batch-select#toggleOption"
                                       <%= "checked" if selected_keys.include?(BatchYearsHelper::INCOMING_GRADE1_KEY) %>>
                                <span class="text-gray-700"><%= incoming_grade1_option_label %></span>
                              </label>
                            <% end %>
                            <% @batch_years.each do |by| %>
                              <% label = @relocation_school_year_pending_commit ? by.display_label_with_grade_after_school_year_advance : by.display_label_with_grade %>
                              <label class="flex items-center gap-2">
                                <input type="checkbox"
                                       class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-600"
                                       value="<%= by.id %>"
                                       data-extra-batch-select-target="checkbox"
                                       data-action="change->extra-batch-select#toggleOption"
                                       <%= "checked" if selected_keys.include?(by.id.to_s) %>>
                                <span class="text-gray-700"><%= label %></span>
                              </label>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <% if @resigned_restorable.present? %>
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="font-semibold text-lg mb-4">離職人員（1 個月內可復職並指定屆數）</h2>
        <p class="text-sm text-gray-600 mb-4">選擇新屆數即復職；不選則維持離職。</p>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">姓名</th>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">復職後屆數</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @resigned_restorable.each do |user| %>
                <tr>
                  <td class="px-4 py-2 text-sm font-medium text-gray-900"><%= user.name %></td>
                  <td class="px-4 py-2">
                    <% selected = draft.dig("resigned_assignments", user.id.to_s).presence %>
                    <%= select_tag "resigned_assignments[#{user.id}]", options_for_select(relocation_by_office_opts, selected), { include_blank: "— 維持離職 —", class: "block shadow-sm rounded-md border border-gray-300 px-3 py-2 text-sm w-48" } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <div class="bg-white rounded-lg shadow p-6" data-controller="relocation-new-personnel">
      <h2 class="font-semibold text-lg mb-4">增加新進人員</h2>
      <p class="text-sm text-gray-600 mb-4">可在此新增學員並指定屆數（不需學號、座號）。預設三列；當每一列皆已填寫姓名與屆數時，會自動多開一列供繼續新增。若某一列改回全空白並離開該列（游標移到別處），該列會自動刪除，但總列數不會少於三列。</p>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">姓名</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">屆數（複選）</th>
            </tr>
          </thead>
          <tbody
            class="bg-white divide-y divide-gray-200"
            id="new-personnel-rows"
            data-relocation-new-personnel-target="tbody"
            data-action="input->relocation-new-personnel#handleInput change->relocation-new-personnel#handleInput focusout->relocation-new-personnel#handleFocusOut"
          >
            <% new_rows = relocation_new_personnel_rows_for_form(draft) %>
            <% new_rows.each do |row| %>
              <tr class="new-personnel-row">
                <td class="px-4 py-2">
                  <input type="text" name="new_personnel[][name]" value="<%= row["name"] %>" placeholder="姓名" aria-label="姓名" class="block shadow-sm rounded-md border border-gray-300 px-3 py-2 text-sm w-40" />
                </td>
                <td class="px-4 py-2">
                  <% selected_ids = Array(row["batch_year_ids"].presence || row["batch_year_id"]).reject(&:blank?).map { |v| incoming_grade1_choice?(v) ? v.to_s : v.to_i } %>
                  <%= select_tag "new_personnel[][batch_year_ids][]",
                                 options_for_select(relocation_by_office_opts, selected_ids),
                                 multiple: true,
                                 required: false,
                                 size: 6,
                                 class: "block shadow-sm rounded-md border border-gray-300 px-3 py-2 text-sm w-64" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <p class="text-xs text-gray-500 mt-2">僅填寫「姓名」與「屆數」的列會建立為新人員；空白列會略過。</p>
      </div>
    </div>

    <div class="flex flex-wrap gap-2 items-center">
      <% commit_submit_data = @relocation_school_year_pending_commit ? { turbo_confirm: "送出後將切換至#{next_roc_on_commit}學年度，且無法由此流程切回。確定？" } : {} %>
      <%= f.submit "儲存屆數指定",
                   class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer",
                   data: commit_submit_data,
                   disabled: true,
                   data: commit_submit_data.merge(relocation_guard_target: "commitButton") %>
      <%= f.submit "儲存草稿", class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium cursor-pointer" %>
      <%= link_to "返回屆數列表", batch_years_path, class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium" %>
      <span class="text-sm text-amber-800" data-relocation-guard-target="hint"></span>
    </div>
  <% end %>
</div>
