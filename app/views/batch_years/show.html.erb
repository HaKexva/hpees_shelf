<% content_for :title, @batch_year.name %>

<div class="w-full max-w-5xl mx-auto px-4 sm:px-0 pb-8">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="font-bold text-4xl"><%= @batch_year.display_label %></h1>
      <p class="text-gray-600 mt-1">
        <% if @batch_year.grade_id.present? %><%= @batch_year.grade_id == BatchYear::GRADE_GRADUATED ? "畢業" : "年級 #{@batch_year.grade_id}" %><% end %>
      </p>
    </div>
    <div class="flex gap-2">
      <%= link_to "編輯屆數", edit_batch_year_path(@batch_year), class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 font-medium" %>
      <%= link_to "書籍列表", books_path(batch_year_id: @batch_year.id), class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
    </div>
  </div>

  <h2 class="font-semibold text-lg mb-4">此屆數書籍（<%= @books.size %> 本）</h2>

  <% if @books.any? %>
    <!-- 桌機版表格 -->
    <div class="bg-white rounded-lg shadow overflow-hidden hidden md:block">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">書名</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ISBN</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">總數</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @books.each do |book| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= link_to book, class: "text-blue-600 hover:text-blue-900" do %>
                  <%= book.title %>
                  <% if book.volume.present? %>
                    （<%= book.volume %>）
                  <% end %>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= format_isbn13(book.isbn) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.total %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- 手機版卡片 -->
    <div class="md:hidden space-y-3">
      <% @books.each do |book| %>
        <div class="bg-white rounded-xl shadow border border-gray-200 p-4">
          <p class="text-sm font-medium text-gray-900">
            <%= link_to book, class: "text-blue-600 hover:text-blue-900" do %>
              <%= book.title %>
              <% if book.volume.present? %>
                （<%= book.volume %>）
              <% end %>
            <% end %>
          </p>
          <div class="mt-2 text-xs text-gray-600 space-y-0.5">
            <p><span class="text-gray-400">ISBN</span> <%= format_isbn13(book.isbn) %></p>
            <p><span class="text-gray-400">總數</span> <%= book.total %></p>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500">此屆數尚無書籍。請在新增書籍時選擇此屆數。</p>
  <% end %>

  <p class="mt-6">
    <%= link_to "返回屆數列表", batch_years_path, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 font-medium" %>
  </p>
</div>
