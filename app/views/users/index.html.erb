<% content_for :title, "人員列表" %>

<div class="w-full max-w-5xl mx-auto px-4 sm:px-0 pb-8">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
    <h1 class="font-bold text-2xl sm:text-4xl text-gray-900">人員列表</h1>
    <div class="flex flex-wrap gap-2 items-center">
      <%= link_to "匯出 CSV", export_users_path(request.query_parameters), class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium" %>
      <%= link_to "匯入 CSV", import_users_path, class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium" %>
      <%= link_to "新增人員", new_user_path, class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
    </div>
  </div>

  <div class="mb-4">
    <%= form_with url: users_path, method: :get, local: true do |f| %>
      <div class="flex flex-wrap items-end gap-4">
        <div class="min-w-0 flex-1 sm:flex-initial sm:w-40">
          <label class="block text-sm font-medium text-gray-700 mb-2">姓名</label>
          <%= text_field_tag :q_name, @filter_q_name, placeholder: "姓名", class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2.5 text-base", onchange: "this.form.submit()" %>
        </div>
        <div class="min-w-0 flex-1 sm:flex-initial sm:w-28">
          <label class="block text-sm font-medium text-gray-700 mb-2">座號</label>
          <%= text_field_tag :q_seat_number, @filter_q_seat_number, placeholder: "座號", class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2.5 text-base", onchange: "this.form.submit()" %>
        </div>
        <div class="min-w-0 flex-1 sm:flex-initial sm:w-28">
          <label class="block text-sm font-medium text-gray-700 mb-2">學號</label>
          <%= text_field_tag :q_id_number, @filter_q_id_number, placeholder: "學號", class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2.5 text-base", onchange: "this.form.submit()" %>
        </div>
        <div class="min-w-0 flex-1 sm:flex-initial sm:w-40">
          <label class="block text-sm font-medium text-gray-700 mb-2">屆數</label>
          <% if global_batch_year_locked? %>
            <div class="block w-full shadow-sm rounded-lg border border-gray-200 bg-gray-50 px-3 py-2.5 text-base text-gray-700">
              <%= current_batch_year&.display_label_with_grade || "（已套用全域屆數）" %>
              <span class="text-xs text-gray-500">（全域）</span>
            </div>
          <% else %>
            <%= f.select :batch_year_id, options_from_collection_for_select(@batch_years, :id, :display_label_with_grade, @filter_batch_year_id), { include_blank: "全部屆數" }, { class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2.5 text-base", onchange: "this.form.submit()" } %>
          <% end %>
        </div>
        <div class="min-w-0 flex-1 sm:flex-initial sm:w-44">
          <label class="block text-sm font-medium text-gray-700 mb-2">排序</label>
          <%= select_tag :sort, options_for_select(
                [
                  [ "姓名（筆畫）", "name_strokes" ],
                  [ "學號", "id_number" ],
                  [ "座號", "seat_number" ]
                ],
                @sort || "name_strokes"
              ),
              class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2.5 text-base",
              onchange: "this.form.submit()" %>
        </div>
        <% users_filters_applied = @filter_q_name.present? || @filter_q_seat_number.present? || @filter_q_id_number.present? || @filter_batch_year_id.present? || (@sort.present? && @sort != "name_strokes") %>
        <% if users_filters_applied %>
          <span class="text-sm text-gray-500 self-center">（已套用篩選）</span>
          <%= link_to "清除全部篩選", users_path, class: "inline-flex items-center self-center rounded-md px-3 py-2 text-sm font-medium border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 whitespace-nowrap" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- 桌機版：表格 + 批次刪除 -->
  <%= form_with url: bulk_destroy_users_path, method: :delete, id: "bulk-destroy-users-form" do |f| %>
    <%= hidden_field_tag :q_name, @filter_q_name if @filter_q_name.present? %>
    <%= hidden_field_tag :q_seat_number, @filter_q_seat_number if @filter_q_seat_number.present? %>
    <%= hidden_field_tag :q_id_number, @filter_q_id_number if @filter_q_id_number.present? %>
    <%= hidden_field_tag :batch_year_id, @filter_batch_year_id if @filter_batch_year_id.present? %>
    <%= hidden_field_tag :sort, @sort if @sort.present? %>
    <div class="hidden md:block">
    <div class="flex gap-2 items-center mb-4">
      <button type="submit" class="inline-flex items-center rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white font-medium cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" id="bulk-destroy-btn" disabled data-turbo-confirm="確定要刪除所選的人員嗎？">
        刪除所選
      </button>
      <span class="text-sm text-gray-500" id="bulk-destroy-count">已選 0 位</span>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left w-12 sticky left-0 bg-gray-50 z-10 border-r border-gray-200">
              <% if @users.any? %>
                <input type="checkbox" id="select-all-users" class="rounded" title="全選" aria-label="全選人員">
              <% end %>
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">姓名</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">屆數</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">學號</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">座號</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">管理員</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">編輯</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">借閱紀錄</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @users.any? %>
            <% @users.each do |user| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-4 w-12 sticky left-0 bg-white z-10 border-r border-gray-200 align-middle">
                  <input type="checkbox" name="user_ids[]" value="<%= user.id %>" class="user-checkbox rounded" title="選擇以刪除" aria-label="選擇人員 <%= user.name %> 以刪除">
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= user.name %>
                  <% if user.resigned? %>
                    <span class="ml-1.5 inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium bg-amber-100 text-amber-800">離職</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= user.batch_year&.display_label || "—" %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= user.admin ? "—" : (user.id_number || "—") %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= user.admin ? "—" : (user.seat_number || "—") %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= user.admin ? "是" : "否" %></td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <%= link_to edit_user_path(user), class: "inline-flex text-indigo-600 hover:text-indigo-900", title: "編輯", aria: { label: "編輯" } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <%= link_to "借閱紀錄",
                              loan_history_path(user_id: user.id),
                              class: "inline-flex items-center rounded-md px-3 py-1.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 text-xs sm:text-sm font-medium" %>
                </td>
              </tr>
            <% end %>
            <% else %>
            <tr>
              <td colspan="9" class="px-6 py-10 text-center text-gray-500">找不到任何人員。</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    </div>
  <% end %>

  <!-- 手機版：Card 風格列表 -->
  <div class="block md:hidden pb-8">
    <% if @users.any? %>
      <div class="space-y-4">
        <% @users.each do |user| %>
          <div class="bg-white rounded-2xl shadow-md border border-gray-100 overflow-hidden">
            <div class="p-4">
              <div class="flex justify-between items-start gap-3">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <p class="text-base font-semibold text-gray-900"><%= user.name %></p>
                    <% if user.resigned? %>
                      <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-amber-100 text-amber-800">離職</span>
                    <% end %>
                    <% if user.admin %>
                      <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-indigo-50 text-indigo-700">管理員</span>
                    <% end %>
                  </div>
                </div>
                <div class="flex items-start flex-wrap justify-end gap-1.5" data-no-row-click>
                  <%= link_to edit_user_path(user), class: "inline-flex items-center justify-center w-9 h-9 rounded-full bg-indigo-50 text-indigo-600 hover:bg-indigo-100 active:bg-indigo-200 shrink-0 transition-colors", title: "編輯", aria: { label: "編輯" } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                  <% end %>
                  <%= link_to "借閱紀錄",
                              loan_history_path(user_id: user.id),
                              class: "inline-flex items-center rounded-md px-2.5 py-1.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 text-xs font-medium shrink-0" %>
                  <%= button_to user_path(user), method: :delete, form: { class: "inline" }, class: "inline-flex items-center justify-center w-9 h-9 rounded-full bg-red-50 text-red-600 hover:bg-red-100 active:bg-red-200 border-0 cursor-pointer shrink-0 transition-colors", data: { turbo_confirm: "確定要刪除此人員嗎？" }, title: "刪除", aria: { label: "刪除" } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 7h12M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2m-9 0h10l-1 12a2 2 0 01-2 2H9a2 2 0 01-2-2L6 7z" />
                    </svg>
                  <% end %>
                </div>
              </div>
              <div class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
                <div class="flex gap-1.5"><span class="text-gray-400 shrink-0">屆數</span><span class="text-gray-700 truncate"><%= user.batch_year&.display_label || "—" %></span></div>
                <div class="flex gap-1.5"><span class="text-gray-400 shrink-0">學號</span><span class="text-gray-700 truncate"><%= user.admin ? "—" : (user.id_number || "—") %></span></div>
                <div class="flex gap-1.5"><span class="text-gray-400 shrink-0">座號</span><span class="text-gray-700"><%= user.admin ? "—" : (user.seat_number || "—") %></span></div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="py-16 text-center">
        <p class="text-gray-500 text-sm">找不到任何人員。</p>
      </div>
    <% end %>
  </div>

  <script>
    (function() {
      var form = document.getElementById('bulk-destroy-users-form');
      if (!form) return;
      var checkboxes = form.querySelectorAll('.user-checkbox');
      var selectAll = document.getElementById('select-all-users');
      var btn = document.getElementById('bulk-destroy-btn');
      var countEl = document.getElementById('bulk-destroy-count');

      function updateState() {
        var n = form.querySelectorAll('.user-checkbox:checked').length;
        btn.disabled = n === 0;
        countEl.textContent = '已選 ' + n + ' 位';
        if (selectAll) selectAll.checked = n > 0 && n === checkboxes.length;
        if (selectAll) selectAll.indeterminate = n > 0 && n < checkboxes.length;
      }

      checkboxes.forEach(function(cb) { cb.addEventListener('change', updateState); });
      if (selectAll) selectAll.addEventListener('change', function() {
        checkboxes.forEach(function(cb) { cb.checked = selectAll.checked; });
        updateState();
      });
      updateState();
    })();
  </script>
</div>
