<% content_for :title, "人員列表" %>

<div class="w-full">
  <div class="flex justify-between items-center mb-6 flex-wrap gap-2">
    <h1 class="font-bold text-4xl">人員列表</h1>
    <div class="flex gap-2 items-center">
      <% if @include_resigned %>
        <%= link_to "隱藏離職人員", users_path, class: "rounded-md px-3 py-2 text-sm bg-gray-200 hover:bg-gray-300 font-medium" %>
      <% else %>
        <%= link_to "顯示離職人員", users_path(include_resigned: "1"), class: "rounded-md px-3 py-2 text-sm bg-gray-100 hover:bg-gray-200 font-medium" %>
      <% end %>
      <%= link_to "匯入 CSV", import_users_path, class: "rounded-md px-3.5 py-2.5 bg-green-600 hover:bg-green-500 text-white block font-medium" %>
      <%= link_to "新增人員", new_user_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
    </div>
  </div>

  <%= form_with url: bulk_destroy_users_path, method: :delete, id: "bulk-destroy-users-form" do |f| %>
    <div class="flex gap-2 items-center mb-4 hidden md:flex">
      <button type="submit" class="rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white font-medium cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" id="bulk-destroy-btn" disabled data-turbo-confirm="確定要刪除所選的人員嗎？">
        刪除所選
      </button>
      <span class="text-sm text-gray-500" id="bulk-destroy-count">已選 0 位</span>
    </div>
    <!-- 桌機版：表格 -->
    <div class="hidden md:block overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left w-12 sticky left-0 bg-gray-50 z-10 border-r border-gray-200">
              <% if @users.any? %>
                <input type="checkbox" id="select-all-users" class="rounded" title="全選">
              <% end %>
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">姓名</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">屆數</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">學號</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">座號</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">管理員</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">標籤</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">編輯</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @users.any? %>
            <% @users.each do |user| %>
              <tr class="hover:bg-gray-50 cursor-pointer user-row" data-user-url="<%= user_path(user) %>" role="button" tabindex="0">
                <td class="px-4 py-4 w-12 sticky left-0 bg-white z-10 border-r border-gray-200 align-middle" data-no-row-click>
                  <input type="checkbox" name="user_ids[]" value="<%= user.id %>" class="user-checkbox rounded" title="選擇以刪除">
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= user.name %>
                  <% if user.resigned? %>
                    <span class="ml-1.5 inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium bg-amber-100 text-amber-800">離職</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= user.batch_year&.display_label || "—" %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= user.admin ? "—" : (user.id_number || "—") %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= user.admin ? "—" : (user.seat_number || "—") %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= user.admin ? "是" : "否" %></td>
                <td class="px-6 py-4 text-sm text-gray-500">
                  <% if user.tag_list.present? %>
                    <span class="inline-flex flex-wrap gap-1">
                      <% user.tag_list.each do |tag_name| %>
                        <span class="inline-flex rounded px-1.5 py-0.5 text-xs font-medium bg-gray-100 text-gray-700"><%= tag_name %></span>
                      <% end %>
                    </span>
                  <% else %>
                    —
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2" data-no-row-click>
                  <% if user.resigned? %>
                    <%= link_to "取消離職", cancel_resignation_user_path(user), method: :post, class: "inline-flex text-amber-700 hover:text-amber-900 text-xs font-medium", data: { turbo_confirm: "確定要取消離職嗎？" } %>
                  <% end %>
                  <%= link_to edit_user_path(user), class: "inline-flex text-indigo-600 hover:text-indigo-900", title: "編輯", aria: { label: "編輯" } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="8" class="px-6 py-10 text-center text-gray-500">找不到任何人員。</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <!-- 手機版：Card 風格列表 -->
  <div class="block md:hidden">
    <% if @users.any? %>
      <div class="space-y-3">
        <% @users.each do |user| %>
          <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-3 flex flex-col gap-1 cursor-pointer user-card" data-user-url="<%= user_path(user) %>" role="button" tabindex="0">
            <div class="flex justify-between items-start gap-2">
              <div>
                <p class="text-sm font-semibold text-gray-900">
                  <%= user.name %>
                  <% if user.resigned? %>
                    <span class="ml-1.5 inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium bg-amber-100 text-amber-800">離職</span>
                  <% end %>
                </p>
                <p class="text-xs text-gray-500 mt-0.5"><%= user.batch_year&.display_label || "—" %></p>
              </div>
              <span class="text-xs text-gray-500 shrink-0"><%= user.admin ? "管理員" : "學號 #{user.id_number || '—'}" %></span>
            </div>
            <div class="mt-1 text-xs text-gray-600 space-y-0.5">
              <% unless user.admin %>
                <p>座號：<%= user.seat_number || "—" %></p>
              <% end %>
              <p>管理員：<%= user.admin ? "是" : "否" %></p>
              <% if user.tag_list.present? %>
                <p class="flex flex-wrap gap-1 mt-1">標籤：<% user.tag_list.each do |tag_name| %><span class="rounded px-1.5 py-0.5 bg-gray-100 text-gray-700"><%= tag_name %></span><% end %></p>
              <% end %>
            </div>
            <div class="flex justify-end gap-2 mt-2 text-xs" data-no-row-click>
              <% if user.resigned? %>
                <%= button_to "取消離職", cancel_resignation_user_path(user), method: :post, class: "inline-flex items-center px-2 py-1 rounded bg-amber-100 text-amber-800 hover:bg-amber-200 text-xs font-medium", data: { turbo_confirm: "確定要取消離職嗎？" } %>
              <% end %>
              <%= link_to edit_user_path(user), class: "inline-flex items-center justify-center w-8 h-8 rounded-full bg-indigo-50 text-indigo-600 hover:bg-indigo-100", title: "編輯", aria: { label: "編輯" } do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                </svg>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="py-8 text-center text-gray-500 text-sm">找不到任何人員。</p>
    <% end %>
  </div>

  <script>
    (function() {
      var form = document.getElementById('bulk-destroy-users-form');
      if (!form) return;
      var checkboxes = form.querySelectorAll('.user-checkbox');
      var selectAll = document.getElementById('select-all-users');
      var btn = document.getElementById('bulk-destroy-btn');
      var countEl = document.getElementById('bulk-destroy-count');

      function updateState() {
        var n = form.querySelectorAll('.user-checkbox:checked').length;
        btn.disabled = n === 0;
        countEl.textContent = '已選 ' + n + ' 位';
        if (selectAll) selectAll.checked = n > 0 && n === checkboxes.length;
        if (selectAll) selectAll.indeterminate = n > 0 && n < checkboxes.length;
      }

      checkboxes.forEach(function(cb) { cb.addEventListener('change', updateState); });
      if (selectAll) selectAll.addEventListener('change', function() {
        checkboxes.forEach(function(cb) { cb.checked = selectAll.checked; });
        updateState();
      });
      updateState();

      form.querySelectorAll('.user-row').forEach(function(row) {
        row.addEventListener('click', function(e) {
          if (e.target.closest('[data-no-row-click]')) return;
          var url = row.getAttribute('data-user-url');
          if (url) window.location = url;
        });
        row.addEventListener('keydown', function(e) {
          if (e.key !== 'Enter' && e.key !== ' ') return;
          if (e.target.closest('[data-no-row-click]')) return;
          e.preventDefault();
          var url = row.getAttribute('data-user-url');
          if (url) window.location = url;
        });
      });
      document.querySelectorAll('.user-card').forEach(function(card) {
        card.addEventListener('click', function(e) {
          if (e.target.closest('[data-no-row-click]')) return;
          var url = card.getAttribute('data-user-url');
          if (url) window.location = url;
        });
        card.addEventListener('keydown', function(e) {
          if (e.key !== 'Enter' && e.key !== ' ') return;
          if (e.target.closest('[data-no-row-click]')) return;
          e.preventDefault();
          var url = card.getAttribute('data-user-url');
          if (url) window.location = url;
        });
      });
    })();
  </script>
</div>
