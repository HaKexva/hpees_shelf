<%= form_with(model: user, class: "contents", data: { controller: "unsaved-form user-form" }) do |form| %>
  <% if user.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2>有 <%= user.errors.count %> 個錯誤，無法儲存此人員：</h2>

      <ul class="list-disc ml-6">
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name, "姓名" %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": user.errors[:name].none?, "border-red-400 focus:outline-red-600": user.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :batch_year_id, "屆數（必填）", class: "block text-sm font-medium text-gray-700" %>

    <!-- 學生：單選屆數 -->
    <div class="<%= 'hidden' if user.admin %> mt-2" data-user-form-target="primaryBatchRow">
      <%= form.collection_select :batch_year_id,
            @batch_years || BatchYear.by_number_desc,
            :id,
            :display_label_with_grade,
            { include_blank: "請選擇屆數" },
            required: true,
            class: [
              "block shadow-sm rounded-md border px-3 py-2 w-full",
              (user.errors[:batch_year_id].none? ? "border-gray-400 focus:outline-blue-600" : "border-red-400 focus:outline-red-600")
            ] %>
    </div>

    <!-- 管理員：多選屆數（美化版） -->
    <div class="<%= 'hidden' unless user.admin %> mt-2" data-user-form-target="extraBatchRow" data-controller="extra-batch-select">
      <!-- Hidden real multi-select for Rails -->
      <%= form.collection_select :extra_batch_year_ids,
            BatchYear.class_batches_by_number_desc,
            :id,
            :display_label_with_grade,
            { include_hidden: false },
            multiple: true,
            class: "hidden",
            data: { extra_batch_select_target: "select" } %>

      <!-- Visible Stimulus multi-select UI -->
      <div class="border border-gray-300 rounded-md px-3 py-2 bg-white">
        <button type="button"
                class="w-full flex justify-between items-center text-sm text-gray-700"
                data-action="click->extra-batch-select#togglePanel"
                aria-haspopup="listbox">
          <span data-extra-batch-select-target="summary">尚未選擇屆數</span>
          <span class="text-gray-400 text-xs">▼</span>
        </button>
        <div class="mt-2 border-t border-gray-200 pt-2 hidden max-h-48 overflow-y-auto"
             data-extra-batch-select-target="panel">
          <div class="flex justify-between items-center mb-1">
            <span class="text-xs text-gray-500">勾選要連結的屆數</span>
            <button type="button"
                    class="text-xs text-gray-400 hover:text-gray-600"
                    data-action="click->extra-batch-select#clearAll">
              清除選取
            </button>
          </div>
          <div class="space-y-1 text-sm">
            <% BatchYear.class_batches_by_number_desc.each do |by| %>
              <label class="flex items-center gap-2">
                <input type="checkbox"
                       class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-600"
                       value="<%= by.id %>"
                       data-extra-batch-select-target="checkbox"
                       data-action="change->extra-batch-select#toggleOption"
                       <%= "checked" if user.extra_batch_year_ids&.include?(by.id) %>>
                <span class="text-gray-700"><%= by.display_label_with_grade %></span>
              </label>
            <% end %>
          </div>
        </div>
      </div>

      <p class="mt-1 text-xs text-gray-500">
        管理員可以在此選擇多個班級屆數；學生只會有一個屆數。
      </p>
    </div>
  </div>

  <% unless user.admin %>
    <div class="my-5">
      <%= form.label :id_number, "學號" %>
      <%= form.text_field :id_number, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": user.errors[:id_number].none?, "border-red-400 focus:outline-red-600": user.errors[:id_number].any?}] %>
    </div>
    <div class="my-5">
      <%= form.label :seat_number, "座號" %>
      <%= form.text_field :seat_number, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": user.errors[:seat_number].none?, "border-red-400 focus:outline-red-600": user.errors[:seat_number].any?}] %>
    </div>
  <% end %>

  <div class="my-5 flex items-center">
    <%= form.check_box :admin,
          class: "h-4 w-4 rounded border-gray-400 text-blue-600 focus:ring-blue-600",
          data: { user_form_target: "adminCheckbox", action: "change->user-form#toggleBatchRows" } %>
    <%= form.label :admin, "管理員", class: "ml-2" %>
  </div>

  <% if User::TagRules.groups.any? %>
    <div class="my-5" data-controller="book-form">
      <% rule_groups = User::TagRules.groups %>
      <% rule_groups.each_with_index do |group, gi| %>
        <% group_label = group["label"].presence || "組別#{gi + 1}" %>
        <% opts = group["options"] || [] %>
        <% opt_tag_names = opts.map { |o| o["tag_name"].to_s }.reject(&:blank?) %>
        <% next if opt_tag_names.empty? %>
        <% current_in_group = (user.tag_list || []).find { |t| opt_tag_names.include?(t) } %>
        <% current_in_groups = (user.tag_list || []).select { |t| opt_tag_names.include?(t) } %>
        <% single = User::TagRules.single_select?(gi) %>
        <% optional = User::TagRules.optional?(gi) %>
        <div class="<%= 'mt-4' if gi > 0 %>">
          <%= form.label "group_#{gi}", "#{group_label}#{optional ? '（可不選）' : '（必填）'}#{single ? '（選一）' : '（可多選）'}", class: "block font-medium text-gray-700 mb-2" %>
          <div class="mt-2 space-y-3">
            <div class="flex flex-wrap gap-2">
              <% if optional %>
                <label class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-sm font-medium bg-gray-100 text-gray-700 cursor-pointer border border-transparent has-[:checked]:bg-blue-100 has-[:checked]:text-blue-800 has-[:checked]:ring-1 has-[:checked]:ring-blue-600 has-[:checked]:border-blue-600">
                  <%= radio_button_tag "user[group_#{gi}]", "", current_in_group.blank? && current_in_groups.empty?, { class: "sr-only peer" } %>
                  <span>— 不選 —</span>
                </label>
              <% end %>
              <% opt_tag_names.each do |tag_name| %>
                <label class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-sm font-medium bg-gray-100 text-gray-700 cursor-pointer border border-transparent has-[:checked]:bg-blue-100 has-[:checked]:text-blue-800 has-[:checked]:ring-1 has-[:checked]:ring-blue-600 has-[:checked]:border-blue-600">
                  <% if single %>
                    <%= radio_button_tag "user[group_#{gi}]", tag_name, (current_in_group == tag_name), { class: "sr-only peer", name: "user[group_#{gi}]", data: { book_form_target: (gi == 0 ? "sourceRadio" : nil), action: (gi == 0 ? "change->book-form#toggleInlineRows" : nil) } } %>
                  <% else %>
                    <%= check_box_tag "user[group_#{gi}][]", tag_name, (user.tag_list || []).include?(tag_name), { class: "sr-only peer", data: (gi == 0 ? { book_form_target: "sourceCheckbox", action: "change->book-form#toggleInlineRows" } : {}) } %>
                  <% end %>
                  <span><%= tag_name %></span>
                </label>
              <% end %>
            </div>
            <% if gi == 0 %>
              <% opt_tag_names_with_inline = opt_tag_names.select { |tn| User::TagRules.option_popup_prompt(0, tn).present? || User::TagRules.option_source(0, tn).present? } %>
              <% opt_tag_names_with_inline.each do |tag_name| %>
                <% label_text = User::TagRules.option_popup_prompt(0, tag_name).presence || tag_name %>
                <% src = User::TagRules.option_source(0, tag_name) %>
                <% is_selected = single ? (current_in_group == tag_name) : (current_in_groups.include?(tag_name)) %>
                <% inline_value = (user.tag_list || []).find { |t| t != tag_name && opt_tag_names.exclude?(t) } %>
                <div class="pt-2 border-t border-gray-200 <%= 'hidden' unless is_selected %>" data-book-form-target="inlineRow" data-book-form-inline-row-value="<%= tag_name %>">
                  <%= label_tag :user_tag_inline, label_text, class: "block text-sm text-gray-600 mb-1" %>
                  <% if src == "admins" %>
                    <% admin_users = User.where(admin: true).order(:name) %>
                    <%= select_tag :user_tag_inline, options_for_select([ [ "請選擇", "" ] ] + admin_users.map { |u| [ u.name, u.name ] }, is_selected ? (user.tag_list - opt_tag_names).first : ""), { class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 w-full max-w-xs" } %>
                  <% elsif src == "users" %>
                    <% all_users = User.order(:name) %>
                    <%= select_tag :user_tag_inline, options_for_select([ [ "請選擇", "" ] ] + all_users.map { |u| [ u.name, u.name ] }, is_selected ? (user.tag_list - opt_tag_names).first : ""), { class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 w-full max-w-xs" } %>
                  <% elsif src == "batch_years" %>
                    <% batch_years_for_select = BatchYear.class_batches_by_number_desc %>
                    <%= select_tag :user_tag_inline, options_for_select([ [ "請選擇", "" ] ] + batch_years_for_select.map { |b| [ b.display_label_with_grade, b.id ] }, ""), { class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 w-full max-w-xs" } %>
                  <% else %>
                    <%= text_field_tag :user_tag_inline, (is_selected ? (user.tag_list - opt_tag_names).first : ""), { placeholder: "手動輸入", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 w-full max-w-xs" } %>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
      <p class="text-sm text-gray-500 mt-1">標籤規則於「設定 → 標籤」中設定「適用於：人員」的組別。</p>
    </div>
  <% else %>
    <div class="my-5">
      <p class="text-sm text-gray-500">請先至「設定」頁面新增標籤，即可建立人員。</p>
    </div>
  <% end %>

  <div class="inline">
    <%= form.submit "儲存", class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
