<% content_for :title, "編輯人員" %>

<div class="w-full">
  <h1 class="font-bold text-4xl">編輯人員</h1>

  <%= render "form", user: @user %>

  <%= button_to "刪除此人員", @user, method: :delete, class: "mt-4 rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer inline-block", data: { turbo_confirm: "確定要刪除此人員嗎？" } %>
  <%= link_to "返回人員列表", users_path, class: "ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
