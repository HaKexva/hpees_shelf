<% content_for :title, "編輯人員" %>

<div class="w-full">
  <h1 class="font-bold text-4xl">編輯人員</h1>

  <%= render "form", user: @user, submit_in_page: true %>

  <div class="mt-4 flex flex-row flex-nowrap gap-2 items-center">
    <%= submit_tag "儲存", form: dom_id(@user), class: "inline-flex items-center justify-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    <%= button_to "刪除此人員", @user, method: :delete, form: { class: "inline" }, class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white font-medium cursor-pointer", data: { turbo_confirm: "確定要刪除此人員嗎？" } %>
    <%= link_to "返回人員列表", users_path, class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium" %>
  </div>
</div>
