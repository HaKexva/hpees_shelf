<% content_for :title, "匯入人員" %>

<div class="w-full max-w-5xl mx-auto px-4 sm:px-0 pb-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">匯入人員</h1>
    <%= link_to "返回人員列表", users_path, class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium" %>
  </div>

  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="font-semibold text-lg mb-4">上傳 CSV 檔案</h2>
    <p class="text-gray-600 mb-4">
      上傳包含<strong>姓名</strong>欄位的 CSV 檔案。可選欄位：<code class="bg-gray-100 px-1 rounded">學號</code>（留空或<strong>6 位數字</strong>）、<code class="bg-gray-100 px-1 rounded">座號</code>（留空或<strong>1～2 位數字</strong>）。Excel 若將學號存成數字，系統會自動轉成整數再檢查。管理員需要手動新增。跨屆數需要分批次新增。<br>
      系統會在下方匯入步驟中<strong>要求選擇「屆數」</strong>並套用到本次匯入的所有人員。<strong>不同屆數為不同人員</strong>；重複僅與<strong>所選屆數</strong>比對。請先選屆數並按「套用屆數更新預覽」後，才會顯示重複狀態。
    </p>

    <%= form_with url: import_users_path, method: :post, multipart: true, class: "space-y-4", data: { turbo: false } do |f| %>
      <div>
        <label for="users_import_file" class="block text-sm font-medium text-gray-700 mb-2">選擇 CSV 檔案</label>
        <input id="users_import_file" type="file" name="file" accept=".csv,text/csv" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" required>
      </div>
      <div>
        <%= f.submit "上傳並預覽", class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <% if @imported_data.present? && @imported_data.any? %>
    <% if @missing_columns.present? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
        <h3 class="font-semibold text-red-800 mb-2">欄位不符，無法匯入</h3>
        <p class="text-red-700 text-sm mb-2">您的 CSV 必須包含「姓名」欄位，請修正後重新上傳：</p>
        <p class="text-red-700 text-sm"><strong>缺少的欄位：</strong> <%= @missing_columns.map { |c| @column_names_zh[c] || c }.join("、") %></p>
      </div>
    <% end %>

    <% if @extra_columns.present? %>
      <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
        <h3 class="font-semibold text-yellow-800 mb-2">欄位提示</h3>
        <p class="text-yellow-700 text-sm"><strong>多餘的欄位（將被忽略）：</strong> <%= @extra_columns.join("、") %></p>
      </div>
    <% end %>

    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="font-semibold text-lg mb-4">
        預覽（共 <%= @imported_data.size %> 筆<%= "：" if @missing_columns.blank? %>
        <% if @missing_columns.blank? %>
          <% preview_ready = @preview_batch_year_id.present? %>
          <% invalid_count = (@invalid_row_indices || []).size %>
          <% duplicate_count = preview_ready ? ((@duplicate_row_indices || []) | (@existing_duplicate_row_indices || [])).size : 0 %>
          <% new_count = preview_ready ? (@imported_data.size - invalid_count - duplicate_count) : nil %>
          <% if preview_ready %>
            <span class="text-green-600"><%= new_count %> 位將匯入</span>，
            <span class="text-yellow-700"><%= duplicate_count %> 位重複</span>，
            <span class="text-red-600"><%= invalid_count %> 位不符合</span>）
          <% else %>
            <span class="text-gray-600">請先選擇屆數並按「套用屆數更新預覽」，才會顯示將匯入／重複筆數。</span>
            <span class="text-red-600">（<%= invalid_count %> 位不符合）</span>）
          <% end %>
        <% else %>
          — 請補齊「姓名」欄位後重新上傳）
        <% end %>
      </h2>

      <% if @missing_columns.present? %>
        <div class="mb-4">
          <div class="overflow-x-auto -mx-2 px-2 sm:mx-0 sm:px-0">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">狀態</th>
                  <% @headers.each do |header| %>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= header %></th>
                  <% end %>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @imported_data.each_with_index do |row, index| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-4 py-2 text-sm">
                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">不符合</span>
                    </td>
                    <% @headers.each do |header| %>
                      <td class="px-4 py-2 text-sm text-gray-900"><%= row[header].to_s.presence || "—" %></td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        <p class="text-gray-600 text-sm">請補齊缺少欄位後重新上傳 CSV，即可進行確認匯入。</p>
      <% else %>
        <% preview_ready = @preview_batch_year_id.present? %>
        <%= form_with url: import_users_path, method: :post, data: { turbo: false }, id: "import-form" do |f| %>
          <input type="hidden" name="confirm" value="true">
          <%= hidden_field_tag :import_data, Base64.strict_encode64(@imported_data.to_json) %>

          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">屆數（必填，套用至所有匯入的人員）</label>
            <%= select_tag :batch_year_id, options_from_collection_for_select(@batch_years || BatchYear.class_batches_by_number_desc, :id, :display_label_with_grade, params[:batch_year_id]), { include_blank: "請選擇屆數", required: true, class: "block w-full max-w-md shadow-sm rounded-md border border-gray-300 px-3 py-2" } %>
          </div>

          <div class="mb-4">
            <%= button_tag "套用屆數更新預覽", type: "submit", name: "refresh_preview", value: "true", class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium cursor-pointer" %>
            <p class="mt-2 text-xs text-gray-600">選擇屆數後按此按鈕，可更新「重複」狀態（與資料庫該屆比對）。再按「確認匯入」完成匯入。</p>
          </div>

          <% invalid_count = (@invalid_row_indices || []).size %>
          <% if invalid_count > 0 %>
            <div class="mb-4">
              <%= button_tag "下載不符合清單 CSV", type: "submit", name: "export_invalid", value: "true", class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white font-medium cursor-pointer" %>
              <p class="mt-2 text-xs text-gray-600">有 <strong><%= invalid_count %></strong> 位不符合：請在下方<strong>表格</strong>內修改標紅的可輸入儲格（缺姓名、學號或座號格式錯誤），再按「套用屆數更新預覽」。下載 CSV 會匯出目前不符合列（缺姓名顯示「請填寫」）。</p>
            </div>
          <% end %>

          <!-- 預覽：僅用表格（含手機橫向捲動）；缺姓名列僅在「姓名」欄可編輯 -->
          <div class="overflow-x-auto mb-4 -mx-2 px-2 sm:mx-0 sm:px-0">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">狀態</th>
                  <% @headers.each do |header| %>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= header %></th>
                  <% end %>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @imported_data.each_with_index do |row, index| %>
                  <% invalid = (@invalid_row_indices || []).include?(index) %>
                  <% duplicate_in_file = preview_ready && !invalid && (@duplicate_row_indices || []).include?(index) %>
                  <% duplicate_existing = preview_ready && !invalid && (@existing_duplicate_row_indices || []).include?(index) %>
                  <tr class="<%= invalid ? 'bg-red-50' : ((duplicate_existing || duplicate_in_file) ? 'bg-yellow-50' : 'hover:bg-gray-50') %>">
                    <td class="px-4 py-2 text-sm">
                      <% if invalid %>
                        <% inv_tags = user_import_row_invalid_tags(row) %>
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">不符合（<%= inv_tags.any? ? inv_tags.join("、") : "資料" %>）</span>
                      <% elsif !preview_ready %>
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700">待選屆數</span>
                      <% elsif duplicate_existing %>
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">重複（已存在）</span>
                      <% elsif duplicate_in_file %>
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">重複（同名）</span>
                      <% else %>
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">新增</span>
                      <% end %>
                    </td>
                    <% @headers.each do |header| %>
                      <% semantic = user_import_header_semantic_key_for_edit(header) %>
                      <% field_invalid = semantic.present? && user_import_preview_field_invalid?(semantic, row) %>
                      <% missing_required = invalid && field_invalid %>
                      <% td_cls = "px-4 py-2 text-sm align-top " + (missing_required ? "bg-red-50" : "text-gray-900") %>
                      <% inp_cls = "block w-full min-w-[5rem] max-w-[20rem] rounded border px-2 py-1 text-sm " + (missing_required ? "border-red-300 bg-red-50 text-red-900" : "border-gray-300 text-gray-900") %>
                      <td class="<%= td_cls %>">
                        <% if invalid && field_invalid %>
                          <%= text_field_tag "edit_rows[#{index}][#{semantic}]", row[header].to_s, class: inp_cls %>
                        <% else %>
                          <span class="<%= missing_required ? 'text-red-700' : '' %>"><%= row[header].to_s.presence || "—" %></span>
                        <% end %>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <p class="mb-4 text-sm text-gray-600">
            確認匯入時，「不符合」的列（缺姓名或學號／座號格式不符）會略過；其餘會依所選屆數匯入，重複人員將跳過。
          </p>

          <div class="flex gap-2 items-center">
            <%= f.submit "確認匯入", class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
            <%= link_to "取消", import_users_path, class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium" %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
