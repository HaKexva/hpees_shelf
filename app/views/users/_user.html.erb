<div id="<%= dom_id user %>" class="py-5 flex flex-col w-full">
  <p class="my-2">
    <strong class="block font-medium text-sm text-gray-500">姓名：</strong>
    <%= user.name %>
    <% if user.resigned? %>
      <span class="ml-1.5 inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium bg-amber-100 text-amber-800">離職</span>
    <% end %>
  </p>

  <% unless user.admin %>
    <p class="my-2">
      <strong class="block font-medium text-sm text-gray-500">學號：</strong>
      <%= user.id_number || "—" %>
    </p>
    <p class="my-2">
      <strong class="block font-medium text-sm text-gray-500">座號：</strong>
      <%= user.seat_number || "—" %>
    </p>
  <% end %>

  <p class="my-2">
    <strong class="block font-medium text-sm text-gray-500">屆數：</strong>
    <%= user.batch_year&.display_label || "—" %>
  </p>

  <p class="my-2">
    <strong class="block font-medium text-sm text-gray-500">管理員：</strong>
    <%= user.admin ? "是" : "否" %>
  </p>

  <% if user.tag_list.present? %>
    <p class="my-2">
      <strong class="block font-medium text-sm text-gray-500">標籤：</strong>
      <span class="inline-flex flex-wrap gap-1">
        <% user.tag_list.each do |tag_name| %>
          <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-800"><%= tag_name %></span>
        <% end %>
      </span>
    </p>
  <% end %>
</div>
