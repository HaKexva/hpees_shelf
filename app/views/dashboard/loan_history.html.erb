<% content_for :title, "借閱紀錄" %>

<div class="w-full">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="font-bold text-2xl sm:text-4xl text-gray-900">借閱紀錄</h1>
      <% if @filter_user.present? %>
        <p class="mt-2 text-base text-gray-700">
          <% if @filter_user.admin? %>
            「<%= @filter_user.name %>（老師）」
          <% else %>
            「<%= @filter_user.name %>（<%= @filter_user.id_number.presence || '—' %>）」
          <% end %>
          <span class="text-gray-600">的借閱紀錄</span>
        </p>
      <% end %>
    </div>
    <div class="flex flex-wrap gap-2 items-center">
      <%= link_to "返回人員列表", users_path(users_list_query_hash), class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium" %>
    </div>
  </div>

  <% if (current_user_admin? || current_user.nil?) && @filter_user_id.blank? %>
    <div class="bg-white rounded-xl shadow-md border border-gray-100 p-6 text-sm text-gray-600">
      請從人員列表點該人列的「借閱紀錄」查看。
    </div>
  <% else %>
    <% if (current_user_admin? || current_user.nil?) && @filter_user_id.present? && @filter_user.blank? %>
      <div class="bg-amber-50 rounded-xl border border-amber-200 p-4 text-sm text-amber-900">
        找不到此借閱人。
      </div>
    <% else %>

  <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden">
    <% if @records.any? %>
      <% show_borrower_column = @filter_user.blank? && (current_user_admin? || current_user.nil?) %>
      <!-- 桌機版表格 -->
      <div class="overflow-x-auto hidden md:block">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <% if show_borrower_column %>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">借閱人</th>
              <% end %>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">書名</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">借出時間</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">歸還時間</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @records.each do |r| %>
              <tr class="hover:bg-gray-50">
                <% if show_borrower_column %>
                  <td class="px-4 py-3 text-sm text-gray-900"><%= r.user&.name %><%= "（老師）" if r.user&.admin? %></td>
                <% end %>
                <td class="px-4 py-3 text-sm text-gray-900"><%= r.book&.title.presence || "—" %></td>
                <td class="px-4 py-3 text-sm text-gray-600"><%= r.borrowed_at&.strftime("%Y-%m-%d %H:%M") || "—" %></td>
                <td class="px-4 py-3 text-sm text-gray-600">
                  <% if r.returned_at.present? %>
                    <%= r.returned_at.strftime("%Y-%m-%d %H:%M") %>
                  <% else %>
                    <span class="text-amber-600 font-medium">借閱中</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- 手機版卡片 -->
      <div class="block md:hidden">
        <div class="divide-y divide-gray-100">
          <% @records.each do |r| %>
            <div class="px-4 py-3">
              <% if show_borrower_column %>
                <p class="text-sm font-medium text-gray-900 mb-1">
                  <%= r.user&.name || "—" %><%= "（老師）" if r.user&.admin? %>
                </p>
              <% end %>
              <p class="text-sm text-gray-900"><%= r.book&.title.presence || "—" %></p>
              <div class="mt-2 space-y-0.5 text-xs text-gray-600">
                <p><span class="text-gray-400">借出</span> <%= r.borrowed_at&.strftime("%Y-%m-%d %H:%M") || "—" %></p>
                <p>
                  <span class="text-gray-400">歸還</span>
                  <% if r.returned_at.present? %>
                    <%= r.returned_at.strftime("%Y-%m-%d %H:%M") %>
                  <% else %>
                    <span class="text-amber-600 font-medium">借閱中</span>
                  <% end %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
        <p class="px-4 py-2 text-xs text-gray-500 border-t border-gray-100">共 <%= @records.size %> 筆（最多顯示 500 筆）</p>
      </div>
    <% else %>
      <% if (current_user_admin? || current_user.nil?) && @filter_user_id.present? && @filter_user.present? %>
        <p class="px-6 py-8 text-center text-gray-500">尚無借閱紀錄。</p>
      <% elsif !(current_user_admin? || current_user.nil?) %>
        <p class="px-6 py-8 text-center text-gray-500">尚無借閱紀錄。</p>
      <% end %>
    <% end %>
  </div>
    <% end %>
  <% end %>
</div>
