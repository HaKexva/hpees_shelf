<% content_for :title, "借閱紀錄" %>

<div class="w-full">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <h1 class="font-bold text-2xl sm:text-4xl text-gray-900">借閱紀錄</h1>
    <%= link_to "返回借還書", root_path, class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium" %>
  </div>

  <% if current_user_admin? || current_user.nil? %>
    <div class="bg-white rounded-xl shadow-md border border-gray-100 p-4 mb-6">
      <%= form_with url: loan_history_path, method: :get, local: true, class: "flex flex-wrap items-end gap-3", id: "loan-history-filter-form" do |f| %>
        <div class="min-w-0 flex-1 sm:max-w-xs relative" data-controller="student-search" data-student-search-placeholder-value="搜尋姓名或學號…">
          <label class="block text-sm font-medium text-gray-700 mb-1">借閱人（姓名／學號）</label>
          <input type="hidden" name="user_id" data-student-search-target="hidden" value="<%= @filter_user_id %>">
          <input
            type="text"
            data-student-search-target="input"
            placeholder="搜尋姓名或學號…"
            autocomplete="off"
            class="block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2 text-sm"
            data-action="focus->student-search#open input->student-search#filter"
          >
          <div
            data-student-search-target="list"
            class="hidden absolute z-10 mt-1 w-full rounded-lg border border-gray-200 bg-white shadow-lg max-h-60 overflow-auto"
            role="listbox"
          >
            <% if @users.present? %>
              <% @users.each do |u| %>
                <% if u.admin? %>
                  <% label = "#{u.name}（老師）" %>
                  <% search_text = "#{u.name} 老師" %>
                <% else %>
                  <% label = "#{u.name}（#{u.id_number.presence || '—'}）" %>
                  <% search_text = "#{u.name} #{u.id_number}" %>
                <% end %>
                <div
                  data-student-search-target="item"
                  data-user-id="<%= u.id %>"
                  data-label="<%= label %>"
                  data-search-text="<%= search_text %>"
                  class="cursor-pointer px-3 py-2.5 text-sm text-gray-900 hover:bg-gray-100 border-b border-gray-50 last:border-0"
                  role="option"
                  data-action="click->student-search#select"
                >
                  <%= label %>
                </div>
              <% end %>
              <p data-student-search-target="emptyHint" class="hidden px-3 py-2.5 text-sm text-gray-500">無符合的學生</p>
            <% else %>
              <p class="px-3 py-2.5 text-sm text-gray-500">尚無學生資料</p>
            <% end %>
          </div>
        </div>
        <%= f.submit "查詢", class: "inline-flex items-center rounded-md px-3.5 py-2 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium cursor-pointer" %>
      <% end %>
    </div>
  <% end %>

  <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden">
    <% if @records.any? %>
      <!-- 桌機版表格 -->
      <div class="overflow-x-auto hidden md:block">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <% if current_user_admin? || current_user.nil? %>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">借閱人</th>
              <% end %>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">書名</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">借出時間</th>
              <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">歸還時間</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @records.each do |r| %>
              <tr class="hover:bg-gray-50">
                <% if current_user_admin? || current_user.nil? %>
                  <td class="px-4 py-3 text-sm text-gray-900"><%= r.user&.name %><%= "（老師）" if r.user&.admin? %></td>
                <% end %>
                <td class="px-4 py-3 text-sm text-gray-900"><%= r.book&.title.presence || "—" %></td>
                <td class="px-4 py-3 text-sm text-gray-600"><%= r.borrowed_at&.strftime("%Y-%m-%d %H:%M") || "—" %></td>
                <td class="px-4 py-3 text-sm text-gray-600">
                  <% if r.returned_at.present? %>
                    <%= r.returned_at.strftime("%Y-%m-%d %H:%M") %>
                  <% else %>
                    <span class="text-amber-600 font-medium">借閱中</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- 手機版卡片 -->
      <div class="block md:hidden">
        <div class="divide-y divide-gray-100">
          <% @records.each do |r| %>
            <div class="px-4 py-3">
              <% if current_user_admin? || current_user.nil? %>
                <p class="text-sm font-medium text-gray-900 mb-1">
                  <%= r.user&.name || "—" %><%= "（老師）" if r.user&.admin? %>
                </p>
              <% end %>
              <p class="text-sm text-gray-900"><%= r.book&.title.presence || "—" %></p>
              <div class="mt-2 space-y-0.5 text-xs text-gray-600">
                <p><span class="text-gray-400">借出</span> <%= r.borrowed_at&.strftime("%Y-%m-%d %H:%M") || "—" %></p>
                <p>
                  <span class="text-gray-400">歸還</span>
                  <% if r.returned_at.present? %>
                    <%= r.returned_at.strftime("%Y-%m-%d %H:%M") %>
                  <% else %>
                    <span class="text-amber-600 font-medium">借閱中</span>
                  <% end %>
                </p>
              </div>
            </div>
          <% end %>
        </div>
        <p class="px-4 py-2 text-xs text-gray-500 border-t border-gray-100">共 <%= @records.size %> 筆（最多顯示 500 筆）</p>
      </div>
    <% else %>
      <p class="px-6 py-8 text-center text-gray-500">
        <% if (current_user_admin? || current_user.nil?) && @filter_user_id.blank? %>
          請選擇借閱人以查看紀錄。
        <% else %>
          尚無借閱紀錄。
        <% end %>
      </p>
    <% end %>
  </div>
</div>
