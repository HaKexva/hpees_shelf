<% content_for :title, "借還書" %>

<div class="w-full max-w-5xl mx-auto px-4 sm:px-0 pb-8">
  <div class="mb-6">
    <h1 class="font-bold text-2xl sm:text-4xl text-gray-900">借還書</h1>
  </div>

  <div class="space-y-8">
    <!-- 借還書表單：管理員可選借/還、ISBN、學生（學號選填）、多本時選冊別 -->
    <div class="bg-white rounded-xl shadow-md border border-gray-100 p-6 space-y-4">
      <% if current_user_admin? || current_user.nil? %>
        <h2 class="font-semibold text-lg text-gray-900 mb-4">借書 / 還書</h2>
        <%= form_with url: process_isbn_path, method: :post, local: true, class: "space-y-4", data: { turbo: false }, id: "scan-form" do |f| %>
          <div>
            <div data-controller="source-filter-buttons">
              <label class="block text-sm font-medium text-gray-700 mb-2">來源（選填）</label>
              <div class="flex flex-wrap gap-2 mb-2">
                <% sources = [ [ "全部", "" ] ] + Book.sources.keys.map { |k| [ t("activerecord.enums.book.source.#{k}"), k ] } %>
                <% sources.each do |label, val| %>
                  <button
                    type="button"
                    class="inline-flex items-center rounded-full border px-3 py-1.5 text-sm font-medium"
                    data-source-filter-buttons-target="button"
                    data-action="click->source-filter-buttons#pick"
                    data-value="<%= val %>"
                  ><%= label %></button>
                <% end %>
              </div>
              <select name="source" class="hidden" aria-hidden="true" tabindex="-1" data-source-filter-buttons-target="select" data-action="change->source-filter-buttons#syncFromSelect">
                <option value="">全部來源</option>
                <% Book.sources.keys.each do |k| %>
                  <option value="<%= k %>"><%= t("activerecord.enums.book.source.#{k}") %></option>
                <% end %>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">借書 或 還書</label>
            <div class="flex gap-4">
              <label class="inline-flex items-center gap-2">
                <input type="radio" name="action_type" value="checkout" checked class="rounded border-gray-300 text-blue-600 focus:ring-blue-600">
                <span class="text-sm font-medium text-gray-700">借書</span>
              </label>
              <label class="inline-flex items-center gap-2">
                <input type="radio" name="action_type" value="return" class="rounded border-gray-300 text-blue-600 focus:ring-blue-600">
                <span class="text-sm font-medium text-gray-700">還書</span>
              </label>
            </div>
          </div>
          <div
            data-controller="dashboard-isbn-validate camera-icon"
            data-dashboard-isbn-validate-url-value="<%= validate_isbn_path %>"
            data-action="student-search:user-selected@window->dashboard-isbn-validate#validateIfReturn"
          >
            <label class="block text-sm font-medium text-gray-700 mb-2">ISBN（掃描或輸入）</label>
            <div class="flex gap-2 items-center">
              <input
                type="text"
                name="isbn"
                id="scan_isbn"
                placeholder="請掃描或輸入 ISBN"
                required
                autocomplete="off"
                class="block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2.5 text-base"
                data-dashboard-isbn-validate-target="input"
                data-action="blur->dashboard-isbn-validate#validate"
              />
              <button
                type="button"
                class="inline-flex items-center justify-center rounded-lg border border-gray-300 px-3 py-2.5 text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 hidden"
                title="使用相機掃描 ISBN"
                aria-label="使用相機掃描 ISBN"
                data-camera-icon-target="button"
                data-action="click->camera-icon#open"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 7h3l2-3h6l2 3h3v11H4z" />
                  <circle cx="12" cy="13" r="4" />
                </svg>
              </button>
            </div>
            <p
              data-dashboard-isbn-validate-target="message"
              class="mt-1 text-sm hidden"
              aria-live="polite"
            ></p>
            <div
              data-dashboard-isbn-validate-target="duplicates"
              class="mt-1 text-xs text-amber-900 hidden"
            ></div>
          </div>
          <div class="relative" data-controller="student-search" data-student-search-placeholder-value="搜尋姓名或學號…">
            <label class="block text-sm font-medium text-gray-700 mb-2">借閱人</label>
            <input type="hidden" name="user_id" data-student-search-target="hidden" value="">
            <input type="text" data-student-search-target="input" placeholder="搜尋姓名或學號…" autocomplete="off" class="block w-full max-w-md shadow-sm rounded-lg border border-gray-300 px-3 py-2.5 text-base" data-action="focus->student-search#open input->student-search#filter">
            <div data-student-search-target="list" class="hidden absolute z-10 mt-1 w-full max-w-md rounded-lg border border-gray-200 bg-white shadow-lg max-h-60 overflow-auto" role="listbox">
              <% if @users.present? %>
                <% @users.each do |u| %>
                  <% if u.admin? %>
                    <% label = "#{u.name}（老師）" %>
                    <% search_text = "#{u.name} 老師" %>
                  <% else %>
                    <% label = "#{u.name}（#{u.id_number.presence || '—'}）" %>
                    <% search_text = "#{u.name} #{u.id_number}" %>
                  <% end %>
                  <div data-student-search-target="item" data-user-id="<%= u.id %>" data-label="<%= label %>" data-search-text="<%= search_text %>" class="cursor-pointer px-3 py-2.5 text-sm text-gray-900 hover:bg-gray-100 border-b border-gray-50 last:border-0" role="option" data-action="click->student-search#select">
                    <%= label %>
                  </div>
                <% end %>
                <p data-student-search-target="emptyHint" class="hidden px-3 py-2.5 text-sm text-gray-500">無符合的學生</p>
              <% else %>
                <p class="px-3 py-2.5 text-sm text-gray-500">尚無學生資料</p>
              <% end %>
            </div>
            <p id="borrower-error" class="mt-1 text-sm text-red-600 hidden">請先選擇借閱人。</p>
          </div>
          <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer">送出</button>
        <% end %>
      <% else %>
        <!-- 學生：只掃 ISBN -->
        <h2 class="font-semibold text-lg text-gray-900 mb-4">掃描借/還書</h2>
        <%= form_with url: process_isbn_path, method: :post, local: true, class: "space-y-4", data: { turbo: false }, id: "scan-form" do |f| %>
          <input type="hidden" name="mode" value="self">
          <div
            data-controller="dashboard-isbn-validate camera-icon"
            data-dashboard-isbn-validate-url-value="<%= validate_isbn_path %>"
          >
            <label class="block text-sm font-medium text-gray-700 mb-2">ISBN（掃描或輸入）</label>
            <div class="flex gap-2 items-center">
              <input
                type="text"
                name="isbn"
                id="scan_isbn"
                placeholder="請掃描或輸入 ISBN"
                required
                autocomplete="off"
                class="block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2.5 text-base"
                data-dashboard-isbn-validate-target="input"
                data-action="blur->dashboard-isbn-validate#validate"
              />
              <button
                type="button"
                class="inline-flex items-center justify-center rounded-lg border border-gray-300 px-3 py-2.5 text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 hidden"
                title="使用相機掃描 ISBN"
                aria-label="使用相機掃描 ISBN"
                data-camera-icon-target="button"
                data-action="click->camera-icon#open"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 7h3l2-3h6l2 3h3v11H4z" />
                  <circle cx="12" cy="13" r="4" />
                </svg>
              </button>
            </div>
            <p
              data-dashboard-isbn-validate-target="message"
              class="mt-1 text-sm hidden"
              aria-live="polite"
            ></p>
            <div
              data-dashboard-isbn-validate-target="duplicates"
              class="mt-1 text-xs text-amber-900 hidden"
            ></div>
          </div>
          <button type="submit" class="w-full sm:w-auto inline-flex items-center justify-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer">送出</button>
        <% end %>
      <% end %>
    </div>

    <!-- 目前借閱中（參考用） -->
    <div class="bg-white rounded-xl shadow-md border border-gray-100 p-6">
      <h2 class="font-semibold text-lg text-gray-900 mb-4">目前借閱中</h2>
      <% if @library_books_borrowed.any? %>
        <ul class="space-y-2">
          <% @library_books_borrowed.each do |book| %>
            <li class="flex flex-wrap items-center justify-between gap-2 py-2 border-b border-gray-100 last:border-0">
              <span class="text-sm text-gray-900"><%= book.title %><%= " #{book.edition_part}" if book.edition_part.present? %></span>
              <span class="text-xs text-gray-500"><%= book.borrowers.any? ? book.borrowers.map(&:name).join("、") + " 借閱" : "借閱中" %> · ISBN <%= format_isbn13(book.isbn) %></span>
            </li>
          <% end %>
        </ul>
        <p class="text-xs text-gray-500 mt-2">還書請在上方選擇「還書」並掃描或輸入該書 ISBN。</p>
      <% else %>
        <p class="text-sm text-gray-500">目前無借閱中的圖書館館藏。</p>
      <% end %>
    </div>
  </div>
</div>

<% if current_user_admin? || current_user.nil? %>
  <script>
    (function() {
      var form = document.getElementById("scan-form");
      if (!form) return;
      var borrowerInput = form.querySelector("[data-student-search-target='input']");
      var borrowerError = document.getElementById("borrower-error");
      var isbnInput = form.querySelector("[data-dashboard-isbn-validate-target='input']");

      if (borrowerInput) {
        borrowerInput.addEventListener("input", function() {
          borrowerInput.classList.remove("border-red-400", "focus:outline-red-600");
          borrowerInput.classList.add("border-gray-300");
          if (borrowerError) borrowerError.classList.add("hidden");
        });

        // 僅還書情境：選完借閱人、離開欄位時，若已輸入 ISBN，重新觸發驗證讓黃色「選擇冊別」區塊出現。
        // 借書時不觸發，避免清空已選冊別。
        borrowerInput.addEventListener("blur", function() {
          var actionType = form.querySelector("input[name='action_type']:checked");
          if (!actionType || actionType.value !== "return") return;
          if (!isbnInput) return;
          var val = isbnInput.value.trim();
          if (val !== "") {
            setTimeout(function() {
              isbnInput.dispatchEvent(new Event("blur", { bubbles: true }));
            }, 0);
          }
        });
      }

      form.addEventListener("submit", function(e) {
        var actionType = form.querySelector("input[name='action_type']:checked");
        if (!actionType || actionType.value !== "checkout") return;
        var hiddenBorrower = form.querySelector("input[name='user_id']");
        if (hiddenBorrower && !hiddenBorrower.value) {
          e.preventDefault();
          if (borrowerInput) {
            borrowerInput.classList.remove("border-gray-300");
            borrowerInput.classList.add("border-red-400", "focus:outline-red-600");
          }
          if (borrowerError) borrowerError.classList.remove("hidden");
        }
      });
    })();
  </script>
<% end %>

