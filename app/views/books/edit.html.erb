<% content_for :title, "編輯書籍" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">編輯書籍</h1>

  <%= render "form", book: @book %>

  <%= link_to "檢視此書籍", @book, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "返回書籍列表", books_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
