<% content_for :title, "編輯書籍" %>

<div class="w-full max-w-5xl mx-auto px-4 sm:px-0 pb-8">
  <div class="md:w-2/3 w-full">
    <h1 class="font-bold text-4xl mb-6">編輯書籍</h1>

    <%= render "form", book: @book %>

    <div class="mt-4 flex flex-col sm:flex-row gap-2">
      <%= button_to "刪除書籍",
                    @book,
                    method: :delete,
                    data: { turbo_confirm: "確定要刪除此書籍嗎？" },
                    form: { class: "inline" },
                    class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 font-medium" %>
      <%= link_to "返回書籍列表",
                  books_path,
                  class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
    </div>
  </div>
</div>
