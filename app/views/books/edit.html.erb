<% content_for :title, "編輯書籍" %>

<div class="w-full max-w-5xl mx-auto px-4 sm:px-0 pb-8">
  <div class="md:w-2/3 w-full">
    <h1 class="font-bold text-4xl mb-6">編輯書籍</h1>

    <%= render "form", book: @book, submit_in_page: true %>

    <div class="mt-4 flex flex-wrap gap-2 items-center">
      <%= submit_tag "儲存", form: dom_id(@book), class: "inline-flex items-center justify-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
      <% if @book.owned_by_library? && @book.status != Book::STATUS_RETURNED_LIBRARY %>
        <%= button_to "歸還圖書館",
                      return_to_library_book_path(@book),
                      method: :post,
                      form: { class: "inline" },
                      class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium cursor-pointer",
                      data: { turbo_confirm: "確定要將此書標記為「歸還圖書館」？" } %>
      <% end %>
      <%= button_to "刪除書籍",
                    @book,
                    method: :delete,
                    data: { turbo_confirm: "確定要刪除此書籍嗎？" },
                    form: { class: "inline" },
                    class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white font-medium cursor-pointer" %>
      <%= link_to "返回書籍列表",
                  books_path,
                  class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium" %>
    </div>
  </div>
</div>
