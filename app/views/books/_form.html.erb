<%= form_with(model: book, html: { id: dom_id(book) }, class: "contents", data: { controller: "unsaved-form book-form" }) do |form| %>
  <% if book.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2>有 <%= book.errors.count %> 個錯誤，無法儲存此書籍：</h2>

      <ul class="list-disc ml-6">
        <% book.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5" data-controller="required-field">
    <%= form.label :title, "書名（必填）" %>
    <%= form.text_field :title, required: true, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": book.errors[:title].none?, "border-red-400 focus:outline-red-600": book.errors[:title].any?}], data: { required_field_target: "input", action: "blur->required-field#blur" } %>
  </div>

  <div class="my-5" data-controller="required-field">
    <%= form.label :batch_year_id, "屆數（必填）" %>
    <%= form.collection_select :batch_year_id, @batch_years || BatchYear.class_batches_by_number_desc, :id, :display_label_with_grade, { include_blank: "請選擇屆數" }, { required: true, class: [ "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", (book.errors[:batch_year_id].none? ? "border-gray-400 focus:outline-blue-600" : "border-red-400 focus:outline-red-600") ], data: { required_field_target: "input", action: "blur->required-field#blur" } } %>
  </div>

  <div class="my-5" data-controller="required-field">
    <%= form.label :source, "來源（必填）" %>
    <%= form.select :source, Book.sources.keys.map { |k| [t("activerecord.enums.book.source.#{k}"), k] }, {}, { required: true, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": book.errors[:source].none?, "border-red-400 focus:outline-red-600": book.errors[:source].any?}], data: { required_field_target: "input", book_form_target: "sourceSelect", action: "blur->required-field#blur change->book-form#toggleFields" } } %>
  </div>

  <div class="my-5" data-book-form-target="relocationBehaviorField" style="<%= 'display: none;' unless book.owned_by_class? %>">
    <%= form.label :relocation_behavior %>
    <%= form.select :relocation_behavior, Book.relocation_behaviors.keys.map { |k| [t("activerecord.enums.book.relocation_behavior_short.#{k}"), k] }, {}, { class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": book.errors[:relocation_behavior].none?, "border-red-400 focus:outline-red-600": book.errors[:relocation_behavior].any?}] } %>
  </div>

  <div class="my-5" data-book-form-target="teacherField" style="<%= 'display: none;' unless book.source == 'owned_by_teacher' %>">
    <%= form.label :user_id, "老師（必填）" %>
    <%= form.collection_select :user_id, @admin_users || [], :id, :name, { include_blank: "請選擇老師" }, { required: book.owned_by_teacher?, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": book.errors[:user_id].none?, "border-red-400 focus:outline-red-600": book.errors[:user_id].any?}], data: { book_form_target: "teacherSelect" } } %>
  </div>

  <div class="my-5" data-controller="required-field" data-book-form-target="callNumberField" style="<%= 'display: none;' unless book.source == 'owned_by_library' %>">
    <%= form.label :call_number, "登錄號（圖書館館藏必填）" %>
    <%= form.text_field :call_number,
          class: [
            "block shadow-sm rounded-md border px-3 py-2 mt-2 w-full",
            (book.errors[:call_number].none? ? "border-gray-400 focus:outline-blue-600" : "border-red-400 focus:outline-red-600")
          ],
          maxlength: 8,
          inputmode: "numeric",
          pattern: "\\d{8}",
          data: { required_field_target: "input", action: "blur->required-field#blur" } %>
  </div>

  <div class="my-5" data-controller="isbn-validate camera-icon required-field">
    <%= form.label :isbn, "ISBN（必填）" %>
    <div class="flex gap-2 items-center mt-2">
      <%= form.text_field :isbn, required: true, class: ["block shadow-sm rounded-md border px-3 py-2 w-full", {"border-gray-400 focus:outline-blue-600": book.errors[:isbn].none?, "border-red-400 focus:outline-red-600": book.errors[:isbn].any?}], data: { required_field_target: "input", isbn_validate_target: "input", action: "blur->required-field#blur blur->isbn-validate#validate" } %>
      <button
        type="button"
        class="inline-flex items-center justify-center shrink-0 rounded-md border border-gray-400 px-3 py-2 text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 hidden"
        title="使用相機掃描 ISBN"
        aria-label="使用相機掃描 ISBN"
        data-camera-icon-target="button"
        data-action="click->camera-icon#open"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 7h3l2-3h6l2 3h3v11H4z" />
          <circle cx="12" cy="13" r="4" />
        </svg>
      </button>
    </div>
    <p data-isbn-validate-target="message" class="mt-1 text-sm hidden" aria-live="polite"></p>
  </div>

  <div class="my-5" data-book-form-target="totalField">
    <%= form.label :total, "總數" %>
    <%= form.number_field :total, min: 1, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": book.errors[:total].none?, "border-red-400 focus:outline-red-600": book.errors[:total].any?}] %>
    <p class="mt-1 text-xs text-gray-500">
      非圖書館館藏（捐贈、班級、老師的書）若有多本，可填 2 以上；圖書館館藏一律視為單冊。
    </p>
  </div>

  <div class="my-5">
    <%= form.label :volume, "冊數" %>
    <%= form.text_field :volume, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": book.errors[:volume].none?, "border-red-400 focus:outline-red-600": book.errors[:volume].any?}] %>
  </div> 

  <div class="my-5">
    <%= form.label :note, "備註" %>
    <%= form.textarea :note, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": book.errors[:note].none?, "border-red-400 focus:outline-red-600": book.errors[:note].any?}] %>
  </div>

  <% unless local_assigns[:submit_in_page] %>
    <div class="inline">
      <%= form.submit "儲存", class: "w-full sm:w-auto inline-flex items-center justify-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
    </div>
  <% end %>
<% end %>
