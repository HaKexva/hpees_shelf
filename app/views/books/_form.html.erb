<%= form_with(model: book, class: "contents", data: { controller: "unsaved-form" }) do |form| %>
  <% if book.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2>有 <%= book.errors.count %> 個錯誤，無法儲存此書籍：</h2>

      <ul class="list-disc ml-6">
        <% book.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :title, "書名" %>
    <%= form.text_field :title, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": book.errors[:title].none?, "border-red-400 focus:outline-red-600": book.errors[:title].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :batch_year_id, "屆數" %>
    <%= form.collection_select :batch_year_id, @batch_years || BatchYear.by_number_desc, :id, :display_label_with_grade, { include_blank: "請選擇屆數" }, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": book.errors[:batch_year_id].none?, "border-red-400 focus:outline-red-600": book.errors[:batch_year_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :isbn, "ISBN" %>
    <%= form.text_field :isbn, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": book.errors[:isbn].none?, "border-red-400 focus:outline-red-600": book.errors[:isbn].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :total, "總數" %>
    <%= form.number_field :total, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": book.errors[:total].none?, "border-red-400 focus:outline-red-600": book.errors[:total].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :volume, "冊數" %>
    <%= form.number_field :volume, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": book.errors[:volume].none?, "border-red-400 focus:outline-red-600": book.errors[:volume].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :note, "備註" %>
    <%= form.textarea :note, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": book.errors[:note].none?, "border-red-400 focus:outline-red-600": book.errors[:note].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit "儲存", class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
