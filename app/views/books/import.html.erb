<% content_for :title, "匯入書籍" %>

<div class="w-full max-w-5xl mx-auto px-4 sm:px-0 pb-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">匯入書籍</h1>
    <%= link_to "返回書籍列表", books_path, class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium" %>
  </div>

  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="font-semibold text-lg mb-4">上傳 CSV 檔案</h2>
    <p class="text-gray-600 mb-4">
      上傳包含以下欄位的 CSV 檔案。<strong>必填：</strong><code class="bg-gray-100 px-1 rounded">書名</code>、<code class="bg-gray-100 px-1 rounded">ISBN</code>（須為 <strong>ISBN-13</strong> 共 13 碼且<strong>校驗碼正確</strong>，可含連字號）、<code class="bg-gray-100 px-1 rounded">來源</code>；<strong>選填：</strong><code class="bg-gray-100 px-1 rounded">總數</code>（預設 1）、<code class="bg-gray-100 px-1 rounded">冊數</code>、<code class="bg-gray-100 px-1 rounded">備註</code>。<br>
      來源可填：圖書館館藏、捐贈的書、班級的書；老師的書請填「姓名＋老師的書」（例如：王小明老師的書）。<br>
      系統會在下方匯入步驟中<strong>要求選擇「屆數」</strong>並套用到本次匯入的所有書籍。<strong>不同屆數視為不同館藏</strong>，重複與否僅與<strong>所選屆數</strong>比對；請先選屆數並按「套用屆數更新預覽」後，才會顯示與資料庫重複的列。
    </p>

    <%= form_with url: import_books_path, method: :post, multipart: true, class: "space-y-4", data: { turbo: false } do |f| %>
      <div>
        <label for="books_import_file" class="block text-sm font-medium text-gray-700 mb-2">選擇 CSV 檔案</label>
        <input id="books_import_file" type="file" name="file" accept=".csv,text/csv" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" required>
      </div>
      <div>
        <%= f.submit "上傳並預覽", class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <% if @imported_data.present? && @imported_data.any? %>
    <% if @missing_columns.present? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
        <h3 class="font-semibold text-red-800 mb-2">欄位不符，無法匯入</h3>
        <p class="text-red-700 text-sm mb-2">您的 CSV 欄位與預期格式不符，請修正您的 CSV 檔案後重新上傳：</p>
        <p class="text-red-700 text-sm"><strong>缺少的欄位：</strong> <%= @missing_columns.map { |c| @column_names_zh[c] || c }.join("、") %></p>
        <p class="text-red-700 text-sm mt-2"><strong>必填欄位：</strong> 書名、ISBN、來源。</p>
      </div>
    <% end %>

    <% if @extra_columns.present? %>
      <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
        <h3 class="font-semibold text-yellow-800 mb-2">欄位提示</h3>
        <p class="text-yellow-700 text-sm"><strong>多餘的欄位（將被忽略）：</strong> <%= @extra_columns.join("、") %></p>
      </div>
    <% end %>

    <% if @preview_batch_year_id.present? && @duplicates.present? && @missing_columns.blank? %>
      <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
        <h3 class="font-semibold text-yellow-800 mb-2">發現 <%= @duplicates.size %> 本重複書籍（所選屆數）</h3>
        <p class="text-yellow-700 text-sm">以下書籍在所選屆數中已存在於資料庫（以黃色標示），請選擇處理方式。</p>
      </div>
    <% end %>

    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="font-semibold text-lg mb-4">
        預覽（共 <%= @imported_data.size %> 筆<%= "：" if @missing_columns.blank? %>
        <% if @missing_columns.blank? %>
          <% preview_ready = @preview_batch_year_id.present? %>
          <% invalid_count = (@invalid_row_indices || []).size %>
          <% duplicate_count = preview_ready ? (@duplicates&.size || 0) : nil %>
          <% new_count = preview_ready ? (@imported_data.size - invalid_count - duplicate_count) : nil %>
          <% if preview_ready %>
            <span class="text-green-600"><%= new_count %> 本新書</span>，
            <span class="text-yellow-700"><%= duplicate_count %> 本重複</span>，
            <span class="text-red-600"><%= invalid_count %> 本不符合</span>）
          <% else %>
            <span class="text-gray-600">請先選擇屆數並按「套用屆數更新預覽」，才會顯示新書／重複筆數。</span>
            <span class="text-red-600">（<%= invalid_count %> 本不符合）</span>）
          <% end %>
        <% else %>
          — 請補齊缺少欄位後重新上傳，無法確認匯入）
        <% end %>
      </h2>

      <% if @missing_columns.present? %>
        <div class="mb-4">
          <!-- 桌機版：表格 -->
          <div class="overflow-x-auto hidden md:block">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">狀態</th>
                  <% @headers.each do |header| %>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= header %></th>
                  <% end %>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @imported_data.each_with_index do |row, index| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-4 py-2 text-sm">
                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">不符合</span>
                    </td>
                    <% @headers.each do |header| %>
                      <td class="px-4 py-2 text-sm text-gray-900"><%= import_cell_display(header, row[header]) %></td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <!-- 手機版：卡片 -->
          <div class="md:hidden space-y-4">
            <% @imported_data.each_with_index do |row, index| %>
              <div class="bg-white rounded-2xl border border-gray-200 p-4 shadow-md">
                <p class="mb-2">
                  <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">不符合</span>
                </p>
                <div class="space-y-1 text-xs text-gray-700">
                  <% @headers.each do |header| %>
                    <div class="flex gap-2">
                      <span class="text-gray-400 shrink-0"><%= header %></span>
                      <span class="flex-1 break-all"><%= import_cell_display(header, row[header]) %></span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <p class="text-gray-600 text-sm">請補齊缺少欄位後重新上傳 CSV，即可進行確認匯入。</p>
      <% else %>
        <% preview_ready = @preview_batch_year_id.present? %>
        <% duplicate_indices = preview_ready ? (@duplicates&.map { |d| d[:index] } || []) : [] %>
        <%= form_with url: import_books_path, method: :post, data: { turbo: false }, id: "import-form" do |f| %>
          <input type="hidden" name="confirm" value="true">
          <%= hidden_field_tag :import_data, Base64.strict_encode64(@imported_data.to_json) %>

          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">屆數（必填，套用至所有匯入的書籍）</label>
            <%= select_tag :batch_year_id, options_from_collection_for_select(BatchYear.class_batches_by_number_desc, :id, :display_label_with_grade, params[:batch_year_id]), { include_blank: "請選擇屆數", required: true, class: "block w-full max-w-md shadow-sm rounded-md border border-gray-300 px-3 py-2" } %>
          </div>

          <div class="mb-4">
            <%= button_tag "套用屆數更新預覽", type: "submit", name: "refresh_preview", value: "true", class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium cursor-pointer" %>
            <p class="mt-2 text-xs text-gray-600">選擇屆數後按此，才會比對該屆資料庫並標示重複（不同屆數為不同書籍）。</p>
          </div>

          <% invalid_count = (@invalid_row_indices || []).size %>
          <% if invalid_count > 0 %>
            <div class="mb-4">
              <%= button_tag "下載不符合清單 CSV", type: "submit", name: "export_invalid", value: "true", class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white font-medium cursor-pointer" %>
              <p class="mt-2 text-xs text-gray-600">會匯出「不符合」的資料列（缺書名／ISBN／來源，或 ISBN 非有效 ISBN-13）；缺欄位將填入「請填寫」。</p>
            </div>
          <% end %>

          <% if preview_ready && @duplicates.present? %>
            <input type="hidden" name="duplicate_action" value="select">
            <p class="mb-4 p-4 bg-yellow-50 rounded-md border border-yellow-200 text-sm text-yellow-800">
              左側「保留」欄位：勾選後該書<strong>總數加一</strong>（不建立新書）。未勾選的重複書籍將被跳過。可使用標題核取方塊全選或取消全選。
            </p>
          <% end %>

          <!-- 桌機版：表格 -->
          <div class="overflow-x-auto mb-4 hidden md:block">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                <% if preview_ready && @duplicates.present? %>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-12 sticky left-0 bg-gray-50 z-10 border-r border-gray-200">
                    <span class="block mb-1">保留</span>
                    <input type="checkbox" id="select-all-duplicates" onchange="toggleAllDuplicates(this.checked)" class="rounded" title="全選/取消重複書籍" aria-label="全選或取消所有重複書籍">
                  </th>
                <% end %>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">狀態</th>
                  <% @headers.each do |header| %>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= header %></th>
                  <% end %>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">登錄號</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% @imported_data.each_with_index do |row, index| %>
                  <% is_duplicate = preview_ready && duplicate_indices.include?(index) %>
                  <tr class="<%= is_duplicate ? 'bg-yellow-50' : 'hover:bg-gray-50' %>">
                    <% if preview_ready && @duplicates.present? %>
                      <td class="px-4 py-2 text-sm w-12 sticky left-0 z-10 border-r border-gray-200 align-middle <%= is_duplicate ? 'bg-yellow-50' : 'bg-white' %>">
                        <% if is_duplicate %>
                          <input type="checkbox" name="selected_duplicates[]" value="<%= index %>" class="duplicate-checkbox rounded" title="勾選以保留匯入" aria-label="保留重複書籍第 <%= index + 1 %> 筆">
                        <% end %>
                      </td>
                    <% end %>
                    <td class="px-4 py-2 text-sm">
                      <% if (@invalid_row_indices || []).include?(index) %>
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">不符合</span>
                      <% elsif !preview_ready %>
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700">待選屆數</span>
                      <% elsif is_duplicate %>
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">重複</span>
                      <% else %>
                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">新增</span>
                      <% end %>
                    </td>
                    <% @headers.each do |header| %>
                      <% required_header =
                           case header.to_s.strip
                           when "書名", "title", "Title" then true
                           when "ISBN", "isbn", "國際標準書號" then true
                           when "來源", "source", "Source" then true
                           else false
                           end %>
                      <% isbn_header = %w[ISBN isbn 國際標準書號].include?(header.to_s.strip) %>
                      <% missing_required = (@invalid_row_indices || []).include?(index) && required_header && row[header].to_s.strip.blank? %>
                      <% isbn_checksum_invalid = (@invalid_row_indices || []).include?(index) && isbn_header && row[header].to_s.strip.present? && !Book.valid_isbn13?(row[header]) %>
                      <td class="px-4 py-2 text-sm <%= (missing_required || isbn_checksum_invalid) ? 'bg-red-50 text-red-700' : (is_duplicate ? 'text-yellow-700' : 'text-gray-900') %>"><%= import_cell_display(header, row[header]) %></td>
                    <% end %>
                    <td class="px-4 py-2 text-sm <%= is_duplicate ? 'text-yellow-700' : 'text-gray-900' %>"><%= import_cell_display("登錄號", row["登錄號"] || row["call_number"]) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <!-- 手機版：卡片 -->
          <div class="md:hidden space-y-4 mb-4">
            <% @imported_data.each_with_index do |row, index| %>
              <% is_duplicate = preview_ready && duplicate_indices.include?(index) %>
              <div class="<%= is_duplicate ? 'bg-yellow-50 border-yellow-200' : 'bg-white border-gray-200' %> rounded-2xl border p-4 shadow-md">
                <div class="flex items-start justify-between gap-2 mb-2">
                  <div>
                    <% if (@invalid_row_indices || []).include?(index) %>
                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">不符合</span>
                    <% elsif !preview_ready %>
                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700">待選屆數</span>
                    <% elsif is_duplicate %>
                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">重複</span>
                    <% else %>
                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">新增</span>
                    <% end %>
                  </div>
                  <% if preview_ready && @duplicates.present? && is_duplicate %>
                    <label class="inline-flex items-center gap-1 text-xs text-gray-700">
                      <input type="checkbox" name="selected_duplicates[]" value="<%= index %>" class="duplicate-checkbox rounded" title="勾選以保留匯入">
                      保留
                    </label>
                  <% end %>
                </div>
                <div class="space-y-1 text-xs text-gray-700">
                  <% @headers.each do |header| %>
                    <div class="flex gap-2">
                      <span class="text-gray-400 shrink-0"><%= header %></span>
                      <% required_header =
                           case header.to_s.strip
                           when "書名", "title", "Title" then true
                           when "ISBN", "isbn", "國際標準書號" then true
                           when "來源", "source", "Source" then true
                           else false
                           end %>
                      <% isbn_header = %w[ISBN isbn 國際標準書號].include?(header.to_s.strip) %>
                      <% missing_required = (@invalid_row_indices || []).include?(index) && required_header && row[header].to_s.strip.blank? %>
                      <% isbn_checksum_invalid = (@invalid_row_indices || []).include?(index) && isbn_header && row[header].to_s.strip.present? && !Book.valid_isbn13?(row[header]) %>
                      <span class="flex-1 break-all <%= (missing_required || isbn_checksum_invalid) ? 'bg-red-50 text-red-700' : (is_duplicate ? 'text-yellow-700' : 'text-gray-900') %>"><%= import_cell_display(header, row[header]) %></span>
                    </div>
                  <% end %>
                  <div class="flex gap-2">
                    <span class="text-gray-400 shrink-0">登錄號</span>
                    <span class="flex-1 break-all <%= is_duplicate ? 'text-yellow-700' : 'text-gray-900' %>"><%= import_cell_display("登錄號", row["登錄號"] || row["call_number"]) %></span>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <div class="flex gap-2 items-center">
            <%= f.submit "確認匯入", class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
            <%= link_to "取消", import_books_path, class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium" %>
          </div>
        <% end %>

        <script>
          function toggleAllDuplicates(checked) {
            document.querySelectorAll('.duplicate-checkbox').forEach(cb => cb.checked = checked);
          }
        </script>
      <% end %>
    </div>
  <% end %>
</div>
