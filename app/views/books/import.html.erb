<% content_for :title, "Import Books" %>

<div class="w-full">
  <% if flash[:alert].present? %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-md inline-block"><%= flash[:alert] %></p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">Import Books</h1>
    <%= link_to "Back to books", books_path, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 block font-medium" %>
  </div>

  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="font-semibold text-lg mb-4">Upload CSV File</h2>
    <p class="text-gray-600 mb-4">
      Upload a CSV file with columns: title, isbn, total, volume, note, grade_id
    </p>

    <%= form_with url: import_books_path, method: :post, multipart: true, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Select CSV file</label>
        <input type="file" name="file" accept=".csv,text/csv" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" required>
      </div>
      <div>
        <%= f.submit "Upload & Preview", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <% if @imported_data.present? && @imported_data.any? %>
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="font-semibold text-lg mb-4">Preview (<%= @imported_data.size %> rows)</h2>

      <div class="overflow-x-auto mb-4">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <% @headers.each do |header| %>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= header %></th>
              <% end %>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @imported_data.each do |row| %>
              <tr class="hover:bg-gray-50">
                <% @headers.each do |header| %>
                  <td class="px-4 py-2 text-sm text-gray-900"><%= row[header] %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= form_with url: import_books_path, method: :post, multipart: true do |f| %>
        <input type="hidden" name="confirm" value="true">
        <input type="hidden" name="file" value="">
        <p class="text-gray-600 mb-4">Re-upload the same file and click "Confirm Import" to save these books.</p>
        <div class="flex gap-2">
          <input type="file" name="file" accept=".csv,text/csv" class="block text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-green-700 hover:file:bg-green-100" required>
          <%= f.submit "Confirm Import", class: "rounded-md px-3.5 py-2.5 bg-green-600 hover:bg-green-500 text-white font-medium cursor-pointer" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
