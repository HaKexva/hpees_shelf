<% content_for :title, "匯入書籍" %>

<div class="w-full">
  <% if flash[:alert].present? %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-md inline-block"><%= flash[:alert] %></p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">匯入書籍</h1>
    <%= link_to "返回書籍列表", books_path, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 block font-medium" %>
  </div>

  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="font-semibold text-lg mb-4">上傳 CSV 檔案</h2>
    <p class="text-gray-600 mb-4">
      上傳包含以下欄位的 CSV 檔案：<code class="bg-gray-100 px-1 rounded">書名</code>、<code class="bg-gray-100 px-1 rounded">ISBN</code>、<code class="bg-gray-100 px-1 rounded">總數</code>、<code class="bg-gray-100 px-1 rounded">冊數</code>、<code class="bg-gray-100 px-1 rounded">備註</code>
    </p>

    <%= form_with url: import_books_path, method: :post, multipart: true, class: "space-y-4", data: { turbo: false } do |f| %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">選擇 CSV 檔案</label>
        <input type="file" name="file" accept=".csv,text/csv" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" required>
      </div>
      <div>
        <%= f.submit "上傳並預覽", class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <% if @imported_data.present? && @imported_data.any? %>
    <% if @missing_columns.present? || @extra_columns.present? %>
      <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
        <h3 class="font-semibold text-yellow-800 mb-2">欄位不符警告</h3>
        <p class="text-yellow-700 text-sm mb-2">您的 CSV 欄位與預期格式不符，請修正您的 CSV 檔案：</p>
        <% if @missing_columns.present? %>
          <p class="text-yellow-700 text-sm"><strong>缺少的欄位：</strong> <%= @missing_columns.join("、") %></p>
        <% end %>
        <% if @extra_columns.present? %>
          <p class="text-yellow-700 text-sm"><strong>多餘的欄位（將被忽略）：</strong> <%= @extra_columns.join("、") %></p>
        <% end %>
        <p class="text-yellow-700 text-sm mt-2"><strong>預期欄位：</strong> 書名、ISBN、總數、冊數、備註</p>
      </div>
    <% end %>

    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="font-semibold text-lg mb-4">預覽（共 <%= @imported_data.size %> 筆）</h2>

      <div class="overflow-x-auto mb-4">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <% @headers.each do |header| %>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= header %></th>
              <% end %>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @imported_data.each do |row| %>
              <tr class="hover:bg-gray-50">
                <% @headers.each do |header| %>
                  <td class="px-4 py-2 text-sm text-gray-900"><%= row[header] %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= form_with url: import_books_path, method: :post, data: { turbo: false } do |f| %>
        <input type="hidden" name="confirm" value="true">
        <%= hidden_field_tag :import_data, Base64.strict_encode64(@imported_data.to_json) %>
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-2">年級（套用至所有匯入的書籍）</label>
          <input type="number" name="grade_id" min="1" class="block w-48 shadow-sm rounded-md border border-gray-300 px-3 py-2" placeholder="輸入年級">
        </div>
        <div class="flex gap-2 items-center">
          <%= f.submit "確認匯入", class: "rounded-md px-3.5 py-2.5 bg-green-600 hover:bg-green-500 text-white font-medium cursor-pointer" %>
          <%= link_to "取消", import_books_path, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 font-medium" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
