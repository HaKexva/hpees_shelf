<div id="<%= dom_id book %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= book.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Isbn:</strong>
    <%= book.isbn %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Total:</strong>
    <%= book.total %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Volume:</strong>
    <%= book.volume %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Note:</strong>
    <%= book.note %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Grade:</strong>
    <%= book.grade_id %>
  </div>
</div>
