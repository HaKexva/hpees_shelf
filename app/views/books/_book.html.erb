<div id="<%= dom_id book %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">書名：</strong>
    <%= book.title %>
    <% if book.volume.present? %>
      （<%= book.volume %>）
    <% end %>
  </div>
  <div>
    <strong class="block font-medium mb-1">ISBN：</strong>
    <%= format_isbn13(book.isbn) %>
    <% if book.invalid_isbn? %><span class="text-amber-600 ml-1" title="ISBN 格式錯誤">⚠ 格式錯誤</span><% end %>
  </div>
  <div>
    <strong class="block font-medium mb-1">總數：</strong>
    <%= book.total %>
  </div>
  <% if book.call_number.present? %>
    <div>
      <strong class="block font-medium mb-1">登錄號：</strong>
      <%= book.call_number %>
    </div>
  <% end %>
  <div>
    <strong class="block font-medium mb-1">備註：</strong>
    <%= book.note %>
  </div>
  <div>
    <strong class="block font-medium mb-1">屆數：</strong>
    <%= book.batch_year&.display_label_with_grade || "—" %>
  </div>
  <div>
    <strong class="block font-medium mb-1">目前狀態：</strong>
    <%= book.display_status %>
  </div>
  <% if book.owned_by_library? && book.borrowers.any? %>
    <div>
      <strong class="block font-medium mb-1">借閱人：</strong>
      <%= book.borrowers.map(&:name).join("、") %>
    </div>
  <% end %>
  <% if book.owned_by_teacher? && book.user.present? %>
    <div>
      <strong class="block font-medium mb-1">老師：</strong>
      <%= link_to book.user.name, edit_user_path(book.user), class: "text-indigo-600 hover:text-indigo-900" %>
    </div>
  <% end %>
</div>
