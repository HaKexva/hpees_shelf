<% content_for :title, "書籍列表" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">書籍列表</h1>
    <div class="flex gap-2">
      <%= link_to "匯入 CSV", import_books_path, class: "rounded-md px-3.5 py-2.5 bg-green-600 hover:bg-green-500 text-white block font-medium" %>
      <%= link_to "新增書籍", new_book_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
    </div>
  </div>

  <%= form_with url: bulk_destroy_books_path, method: :delete, id: "bulk-destroy-books-form" do |f| %>
    <div class="flex gap-2 items-center mb-4">
      <button type="submit" class="rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white font-medium cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" id="bulk-destroy-btn" disabled data-turbo-confirm="確定要刪除所選的書籍嗎？">
        刪除所選
      </button>
      <span class="text-sm text-gray-500" id="bulk-destroy-count">已選 0 本</span>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left w-12 sticky left-0 bg-gray-50 z-10 border-r border-gray-200">
              <% if @books.any? %>
                <input type="checkbox" id="select-all-books" class="rounded" title="全選">
              <% end %>
            </th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">書名</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">屆數</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ISBN</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">冊數</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">總數</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">備註</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">編輯</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @books.any? %>
            <% @books.each do |book| %>
              <tr class="hover:bg-gray-50 cursor-pointer book-row" data-book-url="<%= book_path(book) %>" role="button" tabindex="0">
                <td class="px-4 py-4 w-12 sticky left-0 bg-white z-10 border-r border-gray-200 align-middle" data-no-row-click>
                  <input type="checkbox" name="book_ids[]" value="<%= book.id %>" class="book-checkbox rounded" title="選擇以刪除">
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= book.title %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.batch&.display_label || "—" %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.isbn %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.volume %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.total %></td>
                <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate"><%= book.note %></td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2" data-no-row-click>
                  <%= link_to edit_book_path(book), class: "inline-flex text-indigo-600 hover:text-indigo-900", title: "編輯", aria: { label: "編輯" } do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                  </svg>
                <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="8" class="px-6 py-10 text-center text-gray-500">找不到任何書籍。</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <script>
    (function() {
      var form = document.getElementById('bulk-destroy-books-form');
      if (!form) return;
      var checkboxes = form.querySelectorAll('.book-checkbox');
      var selectAll = document.getElementById('select-all-books');
      var btn = document.getElementById('bulk-destroy-btn');
      var countEl = document.getElementById('bulk-destroy-count');

      function updateState() {
        var n = form.querySelectorAll('.book-checkbox:checked').length;
        btn.disabled = n === 0;
        countEl.textContent = '已選 ' + n + ' 本';
        if (selectAll) selectAll.checked = n > 0 && n === checkboxes.length;
        if (selectAll) selectAll.indeterminate = n > 0 && n < checkboxes.length;
      }

      checkboxes.forEach(function(cb) { cb.addEventListener('change', updateState); });
      if (selectAll) selectAll.addEventListener('change', function() {
        checkboxes.forEach(function(cb) { cb.checked = selectAll.checked; });
        updateState();
      });
      updateState();

      // Click row to view book (except checkbox column and 編輯 link)
      form.querySelectorAll('.book-row').forEach(function(row) {
        row.addEventListener('click', function(e) {
          if (e.target.closest('[data-no-row-click]')) return;
          var url = row.getAttribute('data-book-url');
          if (url) window.location = url;
        });
        row.addEventListener('keydown', function(e) {
          if (e.key !== 'Enter' && e.key !== ' ') return;
          if (e.target.closest('[data-no-row-click]')) return;
          e.preventDefault();
          var url = row.getAttribute('data-book-url');
          if (url) window.location = url;
        });
      });
    })();
  </script>
</div>
