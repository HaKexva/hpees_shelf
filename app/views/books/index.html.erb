<% content_for :title, "書籍列表" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <% if @duplicates.present? && @duplicates.any? %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
      <div class="flex justify-between items-center mb-2">
        <h3 class="font-semibold text-yellow-800">發現 <%= @duplicates.size %> 組重複書籍</h3>
        <%= button_to "刪除所有重複書籍", resolve_duplicate_books_path(delete_all: true), method: :post, class: "px-3 py-1.5 bg-red-600 text-white text-sm rounded hover:bg-red-500", data: { turbo_confirm: "確定要刪除所有重複書籍嗎？（每組只保留一本）" } %>
      </div>
      <p class="text-yellow-700 text-sm mb-4">以下書籍有重複紀錄，請選擇保留或刪除：</p>
      
      <% @duplicates.each do |dup_group| %>
        <div class="bg-white rounded-md p-4 mb-3 border border-yellow-200">
          <p class="font-medium text-gray-900 mb-2">「<%= dup_group.first.title %>」（ISBN: <%= dup_group.first.isbn %>）</p>
          <div class="space-y-2">
            <% dup_group.each do |book| %>
              <div class="flex items-center justify-between bg-gray-50 p-2 rounded">
                <span class="text-sm text-gray-600">
                  ID: <%= book.id %> | 冊數: <%= book.volume %> | 總數: <%= book.total %> | 備註: <%= book.note.presence || "無" %>
                </span>
                <div class="flex gap-2">
                  <%= button_to "保留此本", resolve_duplicate_books_path(keep_id: book.id), method: :post, class: "text-xs px-2 py-1 bg-green-100 text-green-700 rounded hover:bg-green-200" %>
                  <%= button_to "刪除此本", resolve_duplicate_books_path(delete_id: book.id), method: :post, class: "text-xs px-2 py-1 bg-red-100 text-red-700 rounded hover:bg-red-200", data: { turbo_confirm: "確定要刪除此書籍嗎？" } %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">書籍列表</h1>
    <div class="flex gap-2">
      <%= link_to "匯入 CSV", import_books_path, class: "rounded-md px-3.5 py-2.5 bg-green-600 hover:bg-green-500 text-white block font-medium" %>
      <%= link_to "新增書籍", new_book_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">書名</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ISBN</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">冊數</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">總數</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">備註</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if @books.any? %>
          <% @books.each do |book| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= book.title %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.isbn %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.volume %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.total %></td>
              <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate"><%= book.note %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                <%= link_to "檢視", book, class: "text-blue-600 hover:text-blue-900" %>
                <%= link_to "編輯", edit_book_path(book), class: "text-indigo-600 hover:text-indigo-900" %>
                <%= button_to "刪除", book, method: :delete, class: "text-red-600 hover:text-red-900 bg-transparent border-0 cursor-pointer inline", data: { turbo_confirm: "確定要刪除嗎？" } %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="px-6 py-10 text-center text-gray-500">找不到任何書籍。</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
