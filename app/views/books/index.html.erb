<% content_for :title, "書籍列表" %>

<div class="w-full max-w-5xl mx-auto px-4 sm:px-0 pb-8" data-controller="inventory-dialog">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
    <h1 class="font-bold text-2xl sm:text-4xl text-gray-900">書籍列表</h1>
    <div class="flex flex-wrap gap-2 items-center">
      <%= link_to "匯出 CSV", export_books_path(books_export_filter_params), class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium" %>
      <button type="button" class="inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium" data-action="click->inventory-dialog#open">
        匯出盤點表
      </button>
      <%= link_to "匯入 CSV", import_books_path, class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium" %>
      <% if Book.show_return_to_library_button? && @any_library_books_to_return %>
        <%= link_to "歸還圖書館書籍", return_to_library_batch_books_path, class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium" %>
      <% end %>
      <%= link_to "新增書籍", new_book_path, class: "inline-flex items-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
    </div>
  </div>

  <dialog id="inventory-dialog" class="fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 m-0 rounded-2xl p-0 w-[min(92vw,540px)] backdrop:bg-black/40" data-inventory-dialog-target="dialog" data-action="click->inventory-dialog#closeIfBackdrop">
    <div class="bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-xl">
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
        <h2 class="text-lg font-semibold text-gray-900">匯出盤點表</h2>
        <button type="button" class="inline-flex items-center justify-center w-9 h-9 rounded-full hover:bg-gray-100 text-gray-600" data-action="click->inventory-dialog#close" aria-label="關閉">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="px-5 py-5">
        <%= form_with url: inventory_pdf_books_path, method: :get, local: true, data: { turbo: false }, html: { target: "_blank" } do |f| %>
          <%= hidden_field_tag :q, @filter_q if @filter_q.present? %>
          <%= hidden_field_tag :status, @filter_status if @filter_status.present? %>

          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">屆數</label>
              <%= f.select :batch_year_id,
                           options_from_collection_for_select(@batch_years, :id, :display_label_with_grade, @filter_batch_year_id),
                           { include_blank: "請選擇屆數" },
                           { class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2.5 text-base", required: true } %>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">來源</label>
              <%= select_tag :inventory_source,
                             options_for_select(
                               [
                                 [ "全部", "all" ],
                                 [ t("activerecord.enums.book.source.owned_by_library"), "owned_by_library" ],
                                 [ t("activerecord.enums.book.source.donated"), "donated" ],
                                 [ t("activerecord.enums.book.source.owned_by_class"), "owned_by_class" ],
                                 [ "所有老師的書", "teachers_all" ]
                               ] + Array(@inventory_teacher_users).map { |u| [ "#{u.name}老師的書", "teacher:#{u.id}" ] },
                               "all"
                             ),
                             class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2.5 text-base",
                             required: true,
                             data: { inventory_dialog_target: "sourceSelect", action: "change->inventory-dialog#syncSortOptions" } %>
              <p class="mt-2 text-xs text-gray-500">選擇「特定來源」或「指定老師」，盤點表將不顯示「來源」欄位。</p>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">盤點表排序</label>
              <%= select_tag :inventory_sort,
                             options_for_select(
                               [
                                 [ "書名（筆畫）", "title_strokes" ],
                                 [ "ISBN", "isbn" ],
                                 [ "來源", "source" ]
                               ],
                               @inventory_sort
                             ),
                             class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2.5 text-base",
                             data: { inventory_dialog_target: "sortSelect" } %>
            </div>
          </div>

          <div class="mt-6 flex items-center justify-end gap-2">
            <button type="button" class="inline-flex items-center rounded-md px-3.5 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium" data-action="click->inventory-dialog#close">
              取消
            </button>
            <button type="submit" class="inline-flex items-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium">
              匯出 PDF
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </dialog>

  <% if @missing_books.present? %>
    <div class="mb-4 py-3 px-4 sm:py-2 sm:px-3 bg-amber-50 text-amber-900 text-sm rounded-xl border border-amber-200">
      <p class="font-medium mb-1">失蹤書籍（借閱超過一天未還）：</p>
      <ul class="list-disc ml-5 space-y-0.5">
        <% @missing_books.each do |book| %>
          <li class="flex items-center justify-between gap-2">
            <span>
              <span class="font-semibold"><%= book.title %></span>
              <%= " #{book.edition_part}" if book.edition_part.present? %>
              <%= " 冊#{book.volume}" if book.volume.present? %>
              — <%= book.source.present? ? (book.source.to_s == "owned_by_teacher" && book.user&.name.to_s.strip.present? ? "#{book.user.name}老師的書" : t("activerecord.enums.book.source.#{book.source}")) : "—" %>
              <%= " · 登錄號 #{book.call_number}" if book.call_number.present? %>
              · <span class="font-semibold text-amber-900"><%= book.display_status %></span>
              <% if book.borrowers.any? %>
                <span class="text-amber-700">（<%= book.borrowers.map(&:name).join("、") %>）</span>
              <% end %>
              · 借出 <%= time_ago_in_words(book.borrowed_at) %> 前
            </span>
            <%= button_to "歸還", return_shelf_book_path(book), method: :post, class: "inline-flex items-center px-3 py-1.5 rounded-md bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 text-sm font-medium cursor-pointer shrink-0", data: { turbo_confirm: "確定要將此書標記為已歸還？" } %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if @invalid_books.present? %>
    <div class="mb-4 py-3 px-4 sm:py-2 sm:px-3 bg-red-50 text-red-700 text-sm rounded-xl border border-red-200">
      <p class="font-medium mb-1">下列書籍的必填欄位尚未填寫完整：</p>
      <ul class="list-disc ml-5 space-y-0.5">
        <% @invalid_books.each do |book| %>
          <li class="flex items-center justify-between gap-2">
            <span>
              <span class="font-semibold"><%= book.title.presence || "（未填書名）" %></span>
              ：<%= book.missing_required_fields.join("、") %> 未填
            </span>
            <%= link_to edit_book_path(book), class: "inline-flex text-indigo-600 hover:text-indigo-900 shrink-0", title: "編輯", aria: { label: "編輯" } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= form_with url: books_path, method: :get, local: true do |f| %>
      <div class="flex flex-wrap items-end gap-4">
        <div class="min-w-0 flex-1 sm:flex-initial sm:w-40">
          <label class="block text-sm font-medium text-gray-700 mb-2">依書名或 ISBN</label>
          <%= text_field_tag :q, @filter_q, placeholder: "書名或 ISBN", class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2.5 text-base", onchange: "this.form.submit()" %>
        </div>
        <div class="min-w-0 flex-1 sm:flex-initial sm:w-40">
          <label class="block text-sm font-medium text-gray-700 mb-2">屆數</label>
          <%= f.select :batch_year_id, options_from_collection_for_select(@batch_years, :id, :display_label_with_grade, @filter_batch_year_id), { include_blank: "全部屆數" }, { class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2.5 text-base", onchange: "this.form.submit()" } %>
        </div>
        <!-- 手機版換行 -->
        <div class="w-full md:hidden"></div>
        <div class="min-w-0 flex-1 sm:flex-initial sm:w-40">
          <label class="block text-sm font-medium text-gray-700 mb-2">來源</label>
          <% book_source_select_options =
               Book.sources.keys.map { |k| [ t("activerecord.enums.book.source.#{k}"), k ] } +
               [ [ "所有老師的書", "teachers_all" ] ] +
               Array(@inventory_teacher_users).map { |u| [ "#{u.name}老師的書", "teacher:#{u.id}" ] } %>
          <%= select_tag :source, options_for_select(book_source_select_options, @filter_source), { include_blank: "全部來源", class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2.5 text-base", onchange: "this.form.submit()" } %>
        </div>
        <div class="min-w-0 flex-1 sm:flex-initial sm:w-40">
          <label class="block text-sm font-medium text-gray-700 mb-2">狀態</label>
          <%= select_tag :status, options_for_select(Book::STATUS_OPTIONS.map { |label, value| [label, value] }, @filter_status), { include_blank: "全部狀態", class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2.5 text-base", onchange: "this.form.submit()" } %>
        </div>
        <div class="min-w-0 flex-1 sm:flex-initial sm:w-44">
          <label class="block text-sm font-medium text-gray-700 mb-2">排序</label>
          <%= select_tag :sort, options_for_select(
                [
                  [ "書名（筆畫）", "title_strokes" ],
                  [ "來源", "source" ],
                  [ "ISBN", "isbn" ]
                ],
                @list_sort
              ),
              { class: "block w-full shadow-sm rounded-lg border border-gray-300 px-3 py-2.5 text-base", onchange: "this.form.submit()" } %>
        </div>
        <% if @filter_batch_year_id.present? || @filter_q.present? || @filter_source.present? || @filter_status.present? || @list_sort != "title_strokes" %>
          <span class="text-sm text-gray-500 self-center">（已套用篩選）</span>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @books_with_invalid_isbn.present? %>
    <div class="mb-4 py-3 px-4 sm:py-2 sm:px-3 bg-amber-50 text-amber-800 text-sm rounded-xl border border-amber-200">
      <p class="font-medium mb-1">下列書籍的 ISBN 格式錯誤（應為 13 碼且校驗碼正確）：</p>
      <ul class="list-disc ml-5 space-y-0.5">
        <% @books_with_invalid_isbn.each do |book| %>
          <li class="flex items-center justify-between gap-2">
            <span><span class="font-semibold"><%= book.title %></span> — ISBN <%= format_isbn13(book.isbn) %></span>
            <%= link_to edit_book_path(book), class: "inline-flex text-indigo-600 hover:text-indigo-900 shrink-0", title: "編輯", aria: { label: "編輯" } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- 寬螢幕：表格 + 批次刪除 -->
  <div class="hidden lg:block">
    <%= form_with url: bulk_destroy_books_path, method: :delete, id: "bulk-destroy-books-form" do |f| %>
      <%= hidden_field_tag :batch_year_id, @filter_batch_year_id if @filter_batch_year_id.present? %>
      <%= hidden_field_tag :q, @filter_q if @filter_q.present? %>
      <%= hidden_field_tag :source, @filter_source if @filter_source.present? %>
      <%= hidden_field_tag :status, @filter_status if @filter_status.present? %>
      <%= hidden_field_tag :sort, @list_sort if @list_sort.present? %>
      <div class="flex gap-2 items-center mb-4">
        <button type="submit" class="inline-flex items-center rounded-md px-3.5 py-2.5 bg-red-600 hover:bg-red-500 text-white font-medium cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" id="bulk-destroy-btn" disabled data-turbo-confirm="確定要刪除所選的書籍嗎？">
          刪除所選
        </button>
        <span class="text-sm text-gray-500" id="bulk-destroy-count">已選 0 本</span>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left w-12 sticky left-0 bg-gray-50 z-10 border-r border-gray-200">
                <% if @books.any? %>
                  <input type="checkbox" id="select-all-books" class="rounded" title="全選" aria-label="全選書籍">
                <% end %>
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap">書名</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap">屆數</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap">來源</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap">登錄號</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap">總數</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap">備註</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap">編輯</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% if @books.any? %>
              <% @books.each do |book| %>
                <% row_status_class =
                     case book.status
                     when Book::STATUS_ON_SHELF then "bg-green-50"
                     when Book::STATUS_BORROWED then "bg-yellow-50"
                     when Book::STATUS_MISSING then "bg-red-50"
                     else ""
                     end %>
                <tr class="<%= [row_status_class, 'hover:bg-gray-50'].reject(&:blank?).join(' ') %>">
                  <td class="px-4 py-4 w-12 sticky left-0 z-10 border-r border-gray-200 align-middle <%= row_status_class %>">
                    <input type="checkbox" name="book_ids[]" value="<%= book.id %>" class="book-checkbox rounded" title="選擇以刪除" aria-label="選擇書籍 <%= book.title %> 以刪除">
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 group">
                    <div class="relative">
                      <span class="relative inline-block">
                        <%= book.title %>
                        <% if book.volume.present? %>
                          （<%= book.volume %>）
                        <% end %>
                        <% if book.isbn.present? %>
                          <!-- Hover-capable devices: show ISBN on hover without reserving space -->
                          <span
                            class="absolute left-full ml-2 top-1/2 -translate-y-1/2 text-xs font-normal text-gray-700 opacity-0 group-hover:opacity-100 transition-opacity px-2 py-0.5 rounded bg-white/90 backdrop-blur whitespace-nowrap [@media(hover:none)]:hidden"
                          >
                            <%= format_isbn13(book.isbn) %>
                          </span>

                          <details class="group relative inline-block ml-2 align-middle [@media(hover:hover)]:hidden">
                            <summary
                              class="list-none inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-100 text-gray-600 cursor-pointer"
                              aria-label="ISBN"
                              title="顯示 ISBN"
                            >
                              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M12 20a8 8 0 100-16 8 8 0 000 16z" />
                              </svg>
                            </summary>
                            <span
                              class="hidden group-open:inline-block group-hover:inline-block absolute left-full ml-2 top-1/2 -translate-y-1/2 text-xs font-normal text-gray-700 px-2 py-0.5 rounded bg-white shadow border border-gray-200 whitespace-nowrap z-20"
                            >
                              <%= format_isbn13(book.isbn) %>
                            </span>
                          </details>
                        <% end %>
                      </span>
                    </div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.batch_year&.display_label || "—" %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    <% if book.source.present? %>
                      <% if book.source.to_s == "owned_by_teacher" && book.user&.name.to_s.strip.present? %>
                        <%= "#{book.user.name}老師的書" %>
                      <% else %>
                        <%= t("activerecord.enums.book.source.#{book.source}") %>
                      <% end %>
                    <% else %>
                      —
                    <% end %>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.call_number.presence || "—" %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.total %></td>
                  <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate"><%= book.note %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <%= link_to edit_book_path(book), class: "inline-flex text-indigo-600 hover:text-indigo-900", title: "編輯", aria: { label: "編輯" } do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                      </svg>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="13" class="px-6 py-10 text-center text-gray-500">找不到任何書籍。</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <!-- 小螢幕/平板：Card 風格列表 -->
  <div class="block lg:hidden pb-8">
    <% if @books.any? %>
      <div class="space-y-4">
        <% @books.each do |book| %>
          <div class="bg-white rounded-2xl shadow-md border border-gray-100 overflow-hidden">
            <div class="p-4">
              <div class="space-y-3">
                <div class="min-w-0">
                  <p class="text-base font-semibold text-gray-900 leading-snug break-words">
                    <%= book.title %>
                    <% if book.volume.present? %>
                      （<%= book.volume %>）
                    <% end %>
                  </p>
                  <p class="text-xs text-gray-500 mt-1.5"><%= book.batch_year&.display_label_with_grade || "—" %></p>
                </div>
                <div class="flex items-center justify-end gap-1.5" data-no-row-click>
                  <%= link_to edit_book_path(book), class: "inline-flex items-center justify-center w-9 h-9 rounded-full bg-indigo-50 text-indigo-600 hover:bg-indigo-100 active:bg-indigo-200 transition-colors", title: "編輯", aria: { label: "編輯" } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                    </svg>
                  <% end %>
                  <%= button_to book, method: :delete, form: { class: "inline" }, class: "inline-flex items-center justify-center w-9 h-9 rounded-full bg-red-50 text-red-600 hover:bg-red-100 active:bg-red-200 border-0 cursor-pointer transition-colors", data: { turbo_confirm: "確定要刪除此書籍嗎？" }, title: "刪除", aria: { label: "刪除" } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 7h12M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2m-9 0h10l-1 12a2 2 0 01-2 2H9a2 2 0 01-2-2L6 7z" />
                    </svg>
                  <% end %>
                </div>
              </div>
              <div class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
                <% if book.source.present? %>
                  <div class="flex gap-1.5">
                    <span class="text-gray-400 shrink-0">來源</span>
                    <span class="text-gray-700 truncate">
                      <% if book.source.to_s == "owned_by_teacher" && book.user&.name.to_s.strip.present? %>
                        <%= "#{book.user.name}老師的書" %>
                      <% else %>
                        <%= t("activerecord.enums.book.source.#{book.source}") %>
                      <% end %>
                    </span>
                  </div>
                <% end %>
                <% if book.isbn.present? %>
                  <div class="flex gap-1.5 min-w-0"><span class="text-gray-400 shrink-0">ISBN</span><span class="text-gray-700 truncate"><%= format_isbn13(book.isbn) %><% if book.invalid_isbn? %><span class="text-amber-600 ml-0.5" title="ISBN 格式錯誤">⚠</span><% end %></span></div>
                <% end %>
                <% if book.call_number.present? %>
                  <div class="flex gap-1.5"><span class="text-gray-400 shrink-0">登錄號</span><span class="text-gray-700"><%= book.call_number %></span></div>
                <% end %>
                <div class="flex gap-1.5"><span class="text-gray-400 shrink-0">總數</span><span class="text-gray-700"><%= book.total %></span></div>
                <div class="flex gap-1.5 col-span-2"><span class="text-gray-400 shrink-0">狀態</span><span class="text-gray-700"><%= book.display_status %></span></div>
              </div>
              <% if book.note.present? %>
                <p class="text-xs text-gray-500 mt-3 pt-3 border-t border-gray-100 line-clamp-2"><%= book.note %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="py-16 text-center">
        <p class="text-gray-500 text-sm">找不到任何書籍。</p>
      </div>
    <% end %>
  </div>

  <script>
    (function() {
      var form = document.getElementById('bulk-destroy-books-form');
      if (!form) return;
      if (form.dataset.boundBulkDestroy) return;
      form.dataset.boundBulkDestroy = 'true';

      var checkboxes = form.querySelectorAll('.book-checkbox');
      var selectAll = document.getElementById('select-all-books');
      var btn = document.getElementById('bulk-destroy-btn');
      var countEl = document.getElementById('bulk-destroy-count');

      function updateState() {
        var n = form.querySelectorAll('.book-checkbox:checked').length;
        btn.disabled = n === 0;
        countEl.textContent = '已選 ' + n + ' 本';
        if (selectAll) selectAll.checked = n > 0 && n === checkboxes.length;
        if (selectAll) selectAll.indeterminate = n > 0 && n < checkboxes.length;
      }

      checkboxes.forEach(function(cb) { cb.addEventListener('change', updateState); });
      if (selectAll) selectAll.addEventListener('change', function() {
        checkboxes.forEach(function(cb) { cb.checked = selectAll.checked; });
        updateState();
      });
      updateState();
    })();

  </script>
</div>
