<% content_for :title, "Books" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">Books</h1>
    <%= link_to "New book", new_book_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div class="mb-4">
    <label class="block text-sm font-medium text-gray-700 mb-2">Filter by tag</label>
    <%= form_with url: books_path, method: :get, local: true, class: "inline" do |f| %>
      <%= f.select :tag, options_for_select(Book::TAG_FILTER_OPTIONS, @filter_tag), { include_blank: "All tags" }, { class: "block shadow-sm rounded-md border border-gray-300 px-3 py-2 w-48", onchange: "this.form.submit()" } %>
    <% end %>
    <% if @filter_tag.present? %>
      <span class="ml-2 text-sm text-gray-500">(filtered by tag)</span>
    <% end %>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tag</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ISBN</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Volume</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Note</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if @books.any? %>
          <% @books.each do |book| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= book.title %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.tag.presence || "—" %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.isbn %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.volume %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= book.total %></td>
              <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate"><%= book.note %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                <%= link_to "Show", book, class: "text-blue-600 hover:text-blue-900" %>
                <%= link_to "Edit", edit_book_path(book), class: "text-indigo-600 hover:text-indigo-900" %>
                <%= button_to "Delete", book, method: :delete, class: "text-red-600 hover:text-red-900 bg-transparent border-0 cursor-pointer inline", data: { turbo_confirm: "Are you sure?" } %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="7" class="px-6 py-10 text-center text-gray-500">No books found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
